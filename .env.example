# MaaCash — Environment Configuration
# Copy this file to .env and fill in the values.

# Database Provider
# Use "sqlite" for local development/testing
# Use "postgresql" for production
DB_PROVIDER="sqlite"

# Database URL
# For SQLite development:
DATABASE_URL="file:./dev.db"
# For PostgreSQL production:
# DATABASE_URL="postgresql://user:password@localhost:5432/bik_prestige?schema=public"

# Direct (unpooled) database URL â€” PostgreSQL only.
# Required by Prisma schema administration: migrate, db push, db pull.
# On Neon this is the direct hostname (no "-pooler"); DATABASE_URL is the
# pooled hostname used by the running application.
# Not needed for SQLite development, and never used by application queries.
# DIRECT_URL="postgresql://user:password@direct-host:5432/bik_prestige?sslmode=require"

# PostgreSQL integration tests only. Destructive tests refuse production,
# Neon/Render hosts, remote hosts and unrecognized database names.
# PG_DATABASE_URL="postgresql://user:password@127.0.0.1:5432/maacash_test"
# PG_TEST_CONFIRM=DISPOSABLE_TEST_DATABASE

# JWT Secret
# REQUIRED: A strong random string for signing JWT tokens.
# Generate with: openssl rand -base64 32
# NEVER use a weak or default value in production.
JWT_SECRET=""

# Application URL (used for callbacks and redirects)
NEXTAUTH_URL="http://localhost:3000"

# Canonical public origin for metadata, sitemap and robots. Local development
# stays local. Production on Render sets both values in the dashboard to
# https://maacash.bloomcoretech.com.
SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Session Security Policy (seconds)
# Increased for testing/pilot phase to allow multi-device testing.
# Tighten these for production: 300 (5min inactivity), 60 (background), 900 (15min absolute)
SESSION_IDLE_TIMEOUT_SECONDS=28800
SESSION_BACKGROUND_TIMEOUT_SECONDS=7200
SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800

# Node Environment
# Set to "production" for production deployments
# NODE_ENV="development"

# Offline Financial Operations (pilot feature flags)
# Default: false â€” enable for designated pilot devices only
OFFLINE_COLLECTIONS_ENABLED=false
OFFLINE_MOMO_ENABLED=false

# Development Credentials (DO NOT USE IN PRODUCTION)
# Admin:      admin@bikprestige.com / Admin123
# Worker:     kwame@bikprestige.com / Worker123
# Collector:  kwadwo@bikprestige.com / Collector123

# ---------------------------------------------------------------------------
# SECURITY HARDENING (required in production â€” see docs/security/)
# ---------------------------------------------------------------------------
# Dedicated HMAC key for rate-limit / login-throttle bucket identifiers.
# Generate (PowerShell):
#   [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
RATE_LIMIT_HMAC_SECRET=""

# 32-byte AES-256-GCM key for encrypting TOTP secrets at rest.
# Generate (PowerShell):
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
MFA_ENCRYPTION_KEY=""

# MFA rollout policy: "optional" (default, users may enrol) or "enforce"
# (platform operators and tenant administrators must enrol before a session).
MFA_ENFORCEMENT="optional"

# Cloudflare Turnstile. Leave TURNSTILE_ENABLED=false until the widget and both
# keys are configured in Render. Enabling without keys rejects every login.
TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Turnstile host allow-list. The custom domain is canonical. Keep the legacy
# primary Render hostname during the transition so old-origin users can still
# sign in and synchronize pending offline records. Remove it only after the
# owner confirms the old origin can retire.
TURNSTILE_ALLOWED_HOSTNAMES="maacash.bloomcoretech.com,maacash.onrender.com"

# Trust the platform-set client-IP headers (True-Client-IP / CF-Connecting-IP).
# Render sets RENDER=true automatically; set this explicitly for other hosts.
TRUSTED_PROXY_HEADERS="true"

# Optional: comma-separated extra origins allowed to call mutating API routes.
# Leave unset in production: same-origin requests and NEXTAUTH_URL are already
# trusted. Never use a wildcard.
# ALLOWED_ORIGINS="https://maacash.bloomcoretech.com"

# ---------------------------------------------------------------------------
# PLATFORM OIDC SSO (BloomCore Identity) â€” optional, default OFF
# See docs/SSO-INTEGRATION.md. With PLATFORM_OIDC_ENABLED=false nothing changes:
# the SSO routes return 404 and local platform login is untouched.
# ---------------------------------------------------------------------------
PLATFORM_OIDC_ENABLED=false
# Exact OIDC issuer (must match the IdP's iss claim exactly, trailing slash included)
PLATFORM_OIDC_ISSUER=""
PLATFORM_OIDC_CLIENT_ID=""
PLATFORM_OIDC_CLIENT_SECRET=""
# Control Center base URL and the per-product API key. The registered product
# slug remains "bloomcore-one": it is the Control Center identity contract.
PLATFORM_OIDC_CC_BASE=""
PLATFORM_OIDC_CC_API_KEY=""
# Only needed when the app sits behind a proxy that rewrites Host:
# PLATFORM_OIDC_REDIRECT_URI="https://maacash.bloomcoretech.com/platform/login/sso/callback"
# Space-separated scopes (openid is mandatory):
# PLATFORM_OIDC_SCOPES="openid email profile"

# â”€â”€ Zeli subscription commerce â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Paystack secret key. Server-only; never exposed to the browser or committed.
# Use a TEST key outside production and the LIVE key only in production.
# Without it, the checkout screen reports that subscription checkout is not
# configured. Prices come from the database catalogue, never from the request.
PAYSTACK_SECRET_KEY=""

# â”€â”€ Zeli external AI (DeepSeek) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Disabled by default. Approved production processing is locked in code by
# PRODUCTION_PROVIDER_APPROVED = false and requires a reviewed commit plus a
# completed DPIA â€” an environment flag or key alone cannot enable it.
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-flash"
# Set true only in an approved test environment to permit the synthetic probe.
ZELI_SYNTHETIC_TESTING_ALLOWED="false"
# Minimum cohort for the outbound privacy gateway. Values below 5 are raised to 5.
ZELI_GATEWAY_MIN_COHORT="5"
# Required only for the locked approved-production path; leave empty otherwise.
ZELI_PRIVACY_POLICY_VERSION=""
ZELI_APPROVAL_REFERENCE=""

# Lifecycle expiry sweep. Enabled by default; set to "disabled" to stop it.
ZELI_EXPIRY_SCHEDULER=""
# Optional interval override in milliseconds. Values below 60000 are ignored.
ZELI_EXPIRY_INTERVAL_MS=""
