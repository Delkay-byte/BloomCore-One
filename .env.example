# MaaCash — Environment Configuration
# Copy this file to .env and fill in the values.

# Database Provider
# Use "sqlite" for local development/testing
# Use "postgresql" for production
DB_PROVIDER="sqlite"

# Database URL
# For SQLite development:
DATABASE_URL="file:./dev.db"
# For PostgreSQL production:
# DATABASE_URL="postgresql://user:password@localhost:5432/bik_prestige?schema=public"

# Direct (unpooled) database URL â€” PostgreSQL only.
# Required by Prisma schema administration: migrate, db push, db pull.
# On Neon this is the direct hostname (no "-pooler"); DATABASE_URL is the
# pooled hostname used by the running application.
# Not needed for SQLite development, and never used by application queries.
# DIRECT_URL="postgresql://user:password@direct-host:5432/bik_prestige?sslmode=require"

# PostgreSQL integration tests only. Destructive tests refuse production,
# Neon/Render hosts, remote hosts and unrecognized database names.
# PG_DATABASE_URL="postgresql://user:password@127.0.0.1:5432/maacash_test"
# PG_TEST_CONFIRM=DISPOSABLE_TEST_DATABASE

# JWT Secret
# REQUIRED: A strong random string for signing JWT tokens.
# Generate with: openssl rand -base64 32
# NEVER use a weak or default value in production.
JWT_SECRET=""

# Application URL (used for callbacks and redirects)
NEXTAUTH_URL="http://localhost:3000"

# Canonical public origin for metadata, sitemap and robots. Local development
# stays local. Production on Render sets both values in the dashboard to
# https://maacash.bloomcoretech.com.
SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Origin used by scripts/run-risk-retention-cron.mjs. Falls back to SITE_URL.
MAACASH_APP_URL="http://localhost:3000"

# Session Security Policy (seconds)
# Increased for testing/pilot phase to allow multi-device testing.
# Tighten these for production: 300 (5min inactivity), 60 (background), 900 (15min absolute)
SESSION_IDLE_TIMEOUT_SECONDS=28800
SESSION_BACKGROUND_TIMEOUT_SECONDS=7200
SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800

# Node Environment
# Set to "production" for production deployments
# NODE_ENV="development"

# Offline Financial Operations (pilot feature flags)
# Default: false â€” enable for designated pilot devices only
OFFLINE_COLLECTIONS_ENABLED=false
OFFLINE_MOMO_ENABLED=false

# Development Credentials (DO NOT USE IN PRODUCTION)
# Admin:      admin@bikprestige.com / Admin!Pass1234
# Worker:     kwame@bikprestige.com / Worker!Pass1234
# Collector:  kwadwo@bikprestige.com / Collector!Pass1234

# ---------------------------------------------------------------------------
# SECURITY HARDENING (required in production â€” see docs/security/)
# ---------------------------------------------------------------------------
# Dedicated HMAC key for rate-limit / login-throttle bucket identifiers.
# Generate (PowerShell):
#   [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
RATE_LIMIT_HMAC_SECRET=""

# 32-byte AES-256-GCM key for encrypting TOTP secrets at rest.
# Generate (PowerShell):
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
MFA_ENCRYPTION_KEY=""

# MFA rollout policy: "optional" (default, users may enrol) or "enforce"
# (platform operators and tenant administrators must enrol before a session).
MFA_ENFORCEMENT="optional"

# Cloudflare Turnstile. Leave TURNSTILE_ENABLED=false until the widget and both
# keys are configured. Enabling without keys rejects every login (the app now
# also refuses to boot in that state when running on Render).
# The public site key is embedded at BUILD time: after changing it, redeploy with
# a fresh build. It must belong to the SAME Cloudflare widget as the secret.
TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Turnstile host allow-list. Must contain the exact hostname that renders the
# widget, and that hostname must also be listed on the Cloudflare widget. The
# custom domain is canonical; the direct Render host is refused at the edge.
TURNSTILE_ALLOWED_HOSTNAMES="maacash.bloomcoretech.com"

# Trust the platform-set client-IP headers (CF-Connecting-IP only when the
# request also carries a valid edge HMAC proof). Render sets RENDER=true
# automatically; set this explicitly for other hosts.
TRUSTED_PROXY_HEADERS="true"

# Server-side HMAC secret shared with the Cloudflare edge. The edge must add
# x-bloomcore-edge-auth = HMAC_SHA256(EDGE_PROXY_SECRET, cf_connecting_ip).
# Never set this in browser code or commit a value. Missing/short values make
# client-IP attribution fail closed to the shared "unknown" bucket.
EDGE_PROXY_SECRET=""

# Optional: comma-separated extra origins allowed to call mutating API routes.
# Leave unset in production: same-origin requests and NEXTAUTH_URL are already
# trusted. Never use a wildcard.
# ALLOWED_ORIGINS="https://maacash.bloomcoretech.com"

# ---------------------------------------------------------------------------
# PLATFORM OIDC SSO (BloomCore Identity) â€” optional, default OFF
# See docs/SSO-INTEGRATION.md. With PLATFORM_OIDC_ENABLED=false nothing changes:
# the SSO routes return 404 and local platform login is untouched.
# ---------------------------------------------------------------------------
PLATFORM_OIDC_ENABLED=false
# Exact OIDC issuer (must match the IdP's iss claim exactly, trailing slash included)
PLATFORM_OIDC_ISSUER=""
PLATFORM_OIDC_CLIENT_ID=""
PLATFORM_OIDC_CLIENT_SECRET=""
# Control Center base URL and the per-product API key. The registered product
# slug remains "bloomcore-one": it is the Control Center identity contract.
PLATFORM_OIDC_CC_BASE=""
PLATFORM_OIDC_CC_API_KEY=""
# Only needed when the app sits behind a proxy that rewrites Host:
# Required when the feature is enabled. Never derived from the request Host.
# PLATFORM_OIDC_REDIRECT_URI="https://maacash.bloomcoretech.com/platform/login/sso/callback"
# Comma-separated exact allowlist. The chosen redirect must appear here.
# PLATFORM_OIDC_ALLOWED_REDIRECT_URIS="https://maacash.bloomcoretech.com/platform/login/sso/callback"
# Space-separated scopes (openid is mandatory):
# PLATFORM_OIDC_SCOPES="openid email profile"

# â”€â”€ Zeli subscription commerce â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Paystack secret key. Server-only; never exposed to the browser or committed.
# Use a TEST key outside production and the LIVE key only in production.
# Without it, the checkout screen reports that subscription checkout is not
# configured. Prices come from the database catalogue, never from the request.
PAYSTACK_SECRET_KEY=""
# Webhook signing secret from Paystack: Developers -> API configuration.
# Paystack signs events with this secret and sends `Paystack-Signature`
# (timestamped HMAC SHA-512). Optional while the account still delivers the
# legacy `x-paystack-signature`, which is verified with the secret key above.
PAYSTACK_WEBHOOK_SIGNING_SECRET=""
# Only needed during a signing-secret rotation: keep the outgoing secret here
# until the overlap window on the dashboard ends, then remove it.
PAYSTACK_WEBHOOK_SIGNING_SECRET_PREVIOUS=""

# Local-only live-payment testing. Never enables a charge by itself: a live key
# is refused on a developer machine unless the opt-in below is true AND the
# process is development AND the request is loopback AND the database is
# isolated AND the exact tenant is on the allowlist. A hosted deployment keeps
# its normal production behaviour and must never set these.
PAYSTACK_LOCAL_LIVE_TEST="false"

# Offer Bank Transfer on hosted checkout only after Paystack confirms the
# merchant account and currency support that channel.
PAYSTACK_CHECKOUT_BANK_TRANSFER="false"
# Comma-separated tenant ids (preferred) or tenant codes explicitly approved for
# local live testing. The owner never sets this from the browser.
# PAYSTACK_LOCAL_LIVE_ALLOWED_TENANT_IDS="tenant_id_one,tenant_id_two"
# Legacy single-tenant form, still honoured and merged into the allowlist.
# PAYSTACK_LOCAL_TEST_TENANT=""

# â”€â”€ Zeli external AI (DeepSeek) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Disabled by default. Approved production processing is locked in code by
# PRODUCTION_PROVIDER_APPROVED = false and requires a reviewed commit plus a
# completed DPIA â€” an environment flag or key alone cannot enable it.
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-flash"
# Set true only in an approved test environment to permit the synthetic probe.
ZELI_SYNTHETIC_TESTING_ALLOWED="false"
# Minimum cohort for the outbound privacy gateway. Values below 5 are raised to 5.
ZELI_GATEWAY_MIN_COHORT="5"
# Required only for the locked approved-production path; leave empty otherwise.
ZELI_PRIVACY_POLICY_VERSION=""
ZELI_APPROVAL_REFERENCE=""

# Lifecycle expiry sweep. Enabled by default; set to "disabled" to stop it.
ZELI_EXPIRY_SCHEDULER=""
# Optional interval override in milliseconds. Values below 60000 are ignored.
ZELI_EXPIRY_INTERVAL_MS=""

# Internal notification recipient for every verified Paystack payment. The
# in-app platform notification is always created; this address receives the
# matching email through the existing Resend integration. Leave unset to use
# the BloomCore operations inbox.
PLATFORM_PAYMENT_NOTIFICATION_EMAIL="bloomcoretechnologies@gmail.com"

# ---------------------------------------------------------------------------
# Customer receipt messaging (WhatsApp Cloud API / SMS)
# ---------------------------------------------------------------------------
# Meta system-user access token. Never commit a real value.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_GRAPH_VERSION="v23.0"
# Approved utility template and its language. A missing approval is an
# external setup requirement, not something the application can fake.
WHATSAPP_RECEIPT_TEMPLATE="maacash_receipt"
WHATSAPP_TEMPLATE_LANGUAGE="en_US"
# Inbound webhook verification/signature (Meta app dashboard).
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
# Delivery is OFF unless explicitly enabled AND the recipient is allowlisted.
WHATSAPP_DELIVERY_ENABLED="false"
WHATSAPP_DELIVERY_ALLOWLIST=""
# No SMS provider has been selected. The mock adapter never sends.
SMS_PROVIDER=""
SMS_DELIVERY_ENABLED="false"
SMS_DELIVERY_ALLOWLIST=""
# ---------------------------------------------------------------------------
# Transactional email (Resend). The sender domain must be verified in Resend;
# never substitute the public Gmail privacy contact as a sender.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
# Preferred explicit security sender. EMAIL_FROM is the existing fallback.
# EMAIL_FROM_SECURITY="MaaCash Security <security@notifications.bloomcoretech.com>"
# EMAIL_FROM="MaaCash Security <security@notifications.bloomcoretech.com>"
# Set to "disabled" only to stop delivery deliberately; production boot fails.
EMAIL_DELIVERY=""

# ---------------------------------------------------------------------------
# Shared Agent Risk Intelligence (see docs/privacy/RISK-INTELLIGENCE-CONFIGURATION.md)
# ---------------------------------------------------------------------------
# Managed secret store in production. Never reuse the local development salt.
RISK_INTELLIGENCE_SALT=""
# Key versioning. Defaults to version 1; set explicitly only during rotation.
# RISK_INTELLIGENCE_ACTIVE_KEY_VERSION="1"
# RISK_INTELLIGENCE_SUPPORTED_VERSIONS="1"
# RISK_INTELLIGENCE_KEY_V2="" # used only while two keys are matchable
# Verified BloomCore signatory. Required before a controlled agreement can be
# presented or countersigned. Do not infer these from a display name.
BLOOMCORE_AUTHORISED_SIGNATORY_NAME="Saviour Amegayie"
BLOOMCORE_AUTHORISED_SIGNATORY_CAPACITY="Proprietor"
# Owner-confirmed registered office. Set only from the company record.
# BLOOMCORE_REGISTERED_ADDRESS="Hse # L7, Olive St., Akast Rd., Akatsi Volta Region, GHANA"
# Owner-approved public privacy contact. This is not a Resend sender identity.
# Leave empty to use the canonical owner-approved value.
BLOOMCORE_PRIVACY_EMAIL="bloomcoretechnologies@gmail.com"
# Named providers/regions are asserted publicly only when both are set.
RISK_HOSTING_PROVIDERS=""
RISK_HOSTING_REGIONS=""
# Shared secret presented by the daily scheduler. The retention route returns
# 503 until this is configured.
RISK_RETENTION_TOKEN=""
# Additional gazetted Ghana holidays as comma-separated YYYY-MM-DD:Name.
GHANA_EXTRA_PUBLIC_HOLIDAYS=""
# Legacy exact-text hash override. Not used by the controlled owner flow.
RISK_AGREEMENT_HASHES=""
