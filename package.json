{
  "name": "maacash",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "pilot": "node scripts/start-pilot.mjs",
    "prepare-deploy": "node scripts/prepare-deploy.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --config prisma.pg.config.ts",
    "db:migrate:prod": "prisma migrate deploy --config prisma.pg.config.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "zeli:expire": "tsx scripts/zeli-expire.ts",
    "test:security": "vitest run tests/security-hardening.test.ts tests/financial-security.test.ts tests/admin-recovery.test.ts tests/offline-isolation.test.ts tests/staff-status.test.ts tests/tenant-isolation.test.ts",
    "test:e2e": "node scripts/prepare-e2e.mjs && playwright test",
    "test:e2e:ui": "node scripts/prepare-e2e.mjs && playwright test --ui",
    "db:generate:pg": "prisma generate --schema=prisma/schema-pg.prisma",
    "db:migrate:status": "prisma migrate status --config prisma.pg.config.ts",
    "test:prepare": "node scripts/prepare-unit-db.mjs",
    "pretest": "node scripts/prepare-unit-db.mjs",
    "test:pg": "node scripts/prepare-pg-db.mjs && vitest run --config vitest.pg.config.ts",
    "test:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.10",
    "lucide-react": "^1.65.0",
    "next": "^16.4.6",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "source-map-js": "^1.2.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "^6.2.7",
    "prisma": "^7.10.1",
    "tsx": "^4.23.12",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "minimatch@3": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@10": {
      "brace-expansion": "5.0.12"
    },
    "js-yaml": "4.3.2",
    "vite": "8.2.6"
  }
}