// BIK Prestige Enterprise Management Platform - Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL lives in prisma.config.ts for CLI commands and
  // in the driver adapter passed by src/lib/db.ts at runtime.
}

// =====================
// SHARED / CORE
// =====================

model User {
  id                 String    @id @default(cuid())
  tenantId           String?
  email              String    @unique
  fullName           String
  phone              String?
  role               String    @default("worker") // admin | worker | collector (primary role)
  status             String    @default("active")
  passwordHash       String
  forcePasswordReset Boolean   @default(false)
  emailVerified      Boolean   @default(true)
  emailVerifiedAt    DateTime?
  passwordPolicyVersion Int    @default(0)
  momoEnabled        Boolean   @default(false) // Module capability: MoMo worker
  susuEnabled        Boolean   @default(false) // Module capability: Susu collector
  tokenVersion       Int       @default(0) // Bumped to invalidate existing sessions
  mfaEnabled         Boolean   @default(false)
  mfaSecret          String? // AES-256-GCM encrypted TOTP secret
  mfaRecoveryCodes   String? // Legacy JSON array (migrated to MfaRecoveryCode rows)
  mfaPendingSecretAt DateTime? // SEC-15: pending TOTP secret issued at this time
  mfaEnrolledAt      DateTime?
  mfaLastUsedAt      DateTime?
  mfaLastTotpStep    Int? // Last accepted TOTP step (replay prevention)
  locationId         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  location              Location?            @relation(fields: [locationId], references: [id])
  dailyAccounts         DailyAccount[]
  collector             Collector?
  passwordResetTokens   PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  devices               DeviceEnrollment[]
  recordedContributions Contribution[]       @relation("RecordedContributions")
  receivedContributions Contribution[]       @relation("ReceivedContributions")
  recordedMomoTransactions MomoTransaction[] @relation("MomoTransactionRecordedBy")

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([role])
  @@index([status])
  @@index([locationId])
  @@index([tenantId])
}

model Location {
  id           String   @id @default(cuid())
  tenantId     String?
  name         String
  code         String
  description  String?
  address      String?
  contactPhone String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users         User[]
  dailyAccounts DailyAccount[]
  momoTransactions MomoTransaction[]
  assetBalances BranchAssetBalance[]
  outgoingTransfers BranchTransfer[] @relation("TransferSource")
  incomingTransfers BranchTransfer[] @relation("TransferDestination")
  shifts Shift[]
  liquiditySnapshots BranchLiquiditySnapshot[]

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@index([status])
  @@index([code])
  @@index([tenantId])
}

model DailyAccount {
  id           String   @id @default(cuid())
  tenantId     String?
  locationId   String
  workerId     String
  businessDate DateTime

  openingMomoFloat       Decimal @default(0)
  openingCash            Decimal @default(0)
  additionalCashReceived Decimal @default(0)
  additionalMomoFloat    Decimal @default(0)
  totalCashIn            Decimal @default(0)
  totalCashOut           Decimal @default(0)
  totalAirtimeSold       Decimal @default(0)
  totalCashReceived      Decimal @default(0)
  totalCashPaid          Decimal @default(0)
  commission             Decimal @default(0)
  debtsCollected         Decimal @default(0)
  otherIncome            Decimal @default(0)
  closingMomoFloat       Decimal @default(0)
  closingCash            Decimal @default(0)
  totalExpenses          Decimal @default(0)
  calculatedMomoVariance Decimal @default(0)
  calculatedCashVariance Decimal @default(0)
  calculatedDifference   Decimal @default(0)
  differenceStatus       String  @default("balanced")
  reconciliationNote     String?
  // Physical handover confirmation. Separate from accounting review: a reviewed
  // account does not prove the money was received.
  actualAmountReceived Decimal?
  handoverDifference   Decimal?
  handoverNote         String?
  handoverConfirmedAt  DateTime?
  handoverConfirmedBy  String?

  status           String    @default("draft")
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedBy       String?
  correctedAt      DateTime?
  correctedById    String?
  correctionReason String?
  revisionCount    Int       @default(0)

  // Financial source of truth for the day.
  //   aggregate — opening/closing plus manual commission, debts and expenses.
  //   ledger    — commission, debts, other income and expenses derive from the
  //               operational MomoTransaction rows; principal customer
  //               transactions never enter the accountability formula.
  // The mode is set once, explicitly, before any ledger entry is recorded. A
  // historical aggregate row is never converted or back-filled silently.
  ledgerMode               String    @default("aggregate")
  ledgerCutoverAt          DateTime?
  // Where this day's opening figures came from: manual | carried | manual_adjusted
  openingBalanceSource     String    @default("manual")
  carriedFromAccountId     String?
  openingAdjustmentReason  String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  location  Location               @relation(fields: [locationId], references: [id])
  worker    User                   @relation(fields: [workerId], references: [id])
  expenses  Expense[]
  revisions DailyAccountRevision[]
  liquiditySnapshots BranchLiquiditySnapshot[]
  momoTransactions MomoTransaction[]
  shifts Shift[]

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@unique([locationId, businessDate])
  @@index([businessDate])
  @@index([locationId])
  @@index([workerId])
  @@index([status])
  @@index([submittedAt])
  @@index([tenantId])
}

/// Operational MoMo transaction ledger entry.
///
/// Every row is an operator-recorded operational record. Nothing here is a
/// provider confirmation or a statement import; `recordingSource` always says
/// so. Principal customer movements (cash in, cash out, airtime) are retained
/// for operational reporting but never enter the accountability formula, which
/// keeps them from being counted as business revenue or profit.
///
/// Corrections and reversals are append-only. The superseded row keeps all of
/// its original values and only changes status; the successor or reversal row
/// carries the linkage so the full history stays auditable.
model MomoTransaction {
  id                    String    @id @default(cuid())
  tenantId              String?
  locationId            String
  dailyAccountId        String?
  /// The employee the transaction belongs to (the operator who recorded it).
  workerId              String
  /// cash_in | cash_out | airtime_sale | commission | debts_collected |
  /// other_income | expense
  type                  String
  /// mtn | telecel | at_money | other | unassigned
  network               String    @default("unassigned")
  /// inflow | outflow | neutral | reversal
  direction             String
  amount                Decimal   @default(0)
  /// Provider/business commission earned on this transaction. A day-total
  /// commission row (type=commission) takes precedence over per-transaction
  /// commission so the same money is never counted twice.
  commissionAmount      Decimal   @default(0)
  businessDate          DateTime
  occurredAt            DateTime
  /// Operator business reference; unique per tenant.
  reference             String
  /// Provider reference when the operator has one. Optional and non-verified.
  externalReference     String?
  /// manual_operator | statement_import | provider_api (future sources)
  recordingSource       String    @default("manual_operator")
  /// operator_recorded | statement_imported | provider_confirmed | disputed
  /// Only an integration may set provider_confirmed. Manual entry cannot.
  verificationStatus    String    @default("operator_recorded")
  /// Enrolled device that captured the entry, when one is available.
  recordedDeviceId      String?
  recordedDeviceName    String?
  /// Free-text pointer to the receipt, statement line or other evidence.
  supportingEvidence    String?
  /// recorded | reversed | corrected | reversal
  status                String    @default("recorded")
  idempotencyKey        String
  reversesTransactionId String?   @unique
  correctsTransactionId String?
  correctionReason      String?
  note                  String?
  recordedById          String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant       BusinessTenant? @relation(fields: [tenantId], references: [id])
  location     Location        @relation(fields: [locationId], references: [id])
  dailyAccount DailyAccount?   @relation(fields: [dailyAccountId], references: [id])
  worker       User            @relation("MomoTransactionRecordedBy", fields: [workerId], references: [id])
  reversalOf   MomoTransaction? @relation("MomoTransactionReversal", fields: [reversesTransactionId], references: [id])
  reversal     MomoTransaction? @relation("MomoTransactionReversal")

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, reference])
  @@unique([tenantId, network, externalReference])
  @@index([tenantId, businessDate])
  @@index([locationId, businessDate])
  @@index([workerId, businessDate])
  @@index([dailyAccountId, status])
  @@index([type, status])
  @@index([tenantId, verificationStatus])
  @@index([createdAt])
}

/// Declared internal balance for one asset at one location.
///
/// This is an operator declaration, never a provider-confirmed balance.
/// `declaredAt` is the baseline timestamp: transfer movements are applied only
/// when they happened after it, so a newly declared snapshot is not reduced
/// twice by transfers the operator already counted.
model BranchAssetBalance {
  id              String   @id @default(cuid())
  tenantId        String?
  locationId      String
  /// cash | mtn_float | telecel_float | at_money_float
  assetType       String
  declaredBalance Decimal  @default(0)
  declaredAt      DateTime @default(now())
  declaredById    String?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   BusinessTenant? @relation(fields: [tenantId], references: [id])
  location Location        @relation(fields: [locationId], references: [id])

  @@unique([tenantId, locationId, assetType])
  @@index([tenantId, assetType])
  @@index([locationId])
}

/// Internal branch-to-branch transfer of physical cash or declared network
/// float. The lifecycle is append-only: each transition writes an immutable
/// event row, and the transfer row carries the current state plus the actor of
/// every completed step.
model BranchTransfer {
  id                String    @id @default(cuid())
  tenantId          String?
  reference         String
  /// cash | mtn_float | telecel_float | at_money_float
  assetType         String
  /// mtn | telecel | at_money | none (derived from the asset type)
  network           String    @default("none")
  sourceLocationId  String
  destinationLocationId String
  amount            Decimal
  /// draft | requested | approved | dispatched | received | completed |
  /// rejected | cancelled | disputed | variance_investigation
  status            String    @default("requested")
  purpose           String?
  notes             String?
  initiatedById     String
  requestedAt       DateTime?
  approvedById      String?
  approvedAt        DateTime?
  dispatchedById    String?
  dispatchedAt      DateTime?
  /// Receipt number, waybill or other evidence held for the dispatch.
  dispatchEvidence  String?
  receivedById      String?
  receivedAt        DateTime?
  actualAmountReceived Decimal?
  /// Receipt number, count sheet or other evidence held at the destination.
  receiptEvidence   String?
  variance          Decimal?
  varianceReason    String?
  /// Sanctioned partial settlement. `settledAmount` is the value finally
  /// accepted at the destination; `outstandingAmount` is the remainder that the
  /// follow-up transfer or a write-back resolution must cover. This is never a
  /// silent reduction of the dispatched amount: the original `amount` stays.
  settlementStatus  String?
  settledAmount     Decimal?
  outstandingAmount Decimal?
  followUpTransferId String?
  parentTransferId   String?
  settledById       String?
  settledAt         DateTime?

  /// The transfer that settles the remaining balance of this one (many
  /// follow-ups may settle one original, so this side is not unique).
  followUps      BranchTransfer[] @relation("TransferFollowUp")
  /// Set when this transfer was created to settle an earlier partial receipt.
  parentTransfer BranchTransfer?  @relation("TransferFollowUp", fields: [parentTransferId], references: [id])
  rejectedById      String?
  rejectedAt        DateTime?
  rejectionReason   String?
  cancelledById     String?
  cancelledAt       DateTime?
  cancellationReason String?
  resolvedById      String?
  resolvedAt        DateTime?
  resolutionNote    String?
  idempotencyKey    String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant      BusinessTenant? @relation(fields: [tenantId], references: [id])
  source      Location        @relation("TransferSource", fields: [sourceLocationId], references: [id])
  destination Location        @relation("TransferDestination", fields: [destinationLocationId], references: [id])
  events      BranchTransferEvent[]

  @@unique([tenantId, reference])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@index([sourceLocationId, assetType])
  @@index([destinationLocationId, assetType])
  @@index([status])
}

/// Immutable lifecycle history for a branch transfer.
model BranchTransferEvent {
  id         String   @id @default(cuid())
  tenantId   String?
  transferId String
  action     String
  actorId    String
  actorName  String?
  note       String?
  createdAt  DateTime @default(now())

  transfer BranchTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId, createdAt])
  @@index([tenantId, createdAt])
}

/// A working shift at one location on one business day.
///
/// A daily account can have several shifts. Shifts are accountability
/// snapshots: their opening/closing figures are never added into the daily
/// account's reconciliation, so the two records cannot double count.
model Shift {
  id             String   @id @default(cuid())
  tenantId       String?
  locationId     String
  dailyAccountId String?
  reference      String
  businessDate   DateTime
  /// morning | afternoon | evening | custom
  name           String
  label          String?
  assignedUserId String
  /// draft | open | awaiting_handover | variance_open | closed | cancelled
  status         String   @default("draft")
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  openingCash    Decimal  @default(0)
  openingMomoFloat Decimal @default(0)
  /// manual | carried | manual_adjusted
  openingSource  String   @default("manual")
  carriedFromShiftId String?
  openingAdjustmentReason String?
  closingCash    Decimal?
  closingMomoFloat Decimal?
  closingNotes   String?
  openedById     String?
  openedAt       DateTime?
  closedById     String?
  closedAt       DateTime?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       BusinessTenant? @relation(fields: [tenantId], references: [id])
  location     Location        @relation(fields: [locationId], references: [id])
  dailyAccount DailyAccount?   @relation(fields: [dailyAccountId], references: [id])
  handovers    ShiftHandover[]
  revisions    ShiftRevision[]

  @@unique([tenantId, locationId, businessDate, name])
  @@unique([tenantId, reference])
  @@index([tenantId, businessDate])
  @@index([locationId, businessDate])
  @@index([assignedUserId, businessDate])
  @@index([status])
}

/// Two-sided shift handover. The outgoing employee's declared figures are
/// immutable once submitted; the receiving employee records their own counted
/// figures separately. A difference is preserved as a variance and stays open
/// until an administrator resolves it.
model ShiftHandover {
  id                  String   @id @default(cuid())
  tenantId            String?
  shiftId             String
  reference           String
  outgoingUserId      String
  outgoingCash        Decimal
  outgoingMomoFloat   Decimal
  outstandingOperations String?
  outgoingNotes       String?
  /// Count sheet, till slip or other evidence held for the outgoing count.
  outgoingEvidence    String?
  incomingUserId      String?
  incomingCash        Decimal?
  incomingMomoFloat   Decimal?
  operationsAccepted  Boolean?
  incomingNotes       String?
  /// Count sheet, receipt or other evidence held for the receiving count.
  incomingEvidence    String?
  cashVariance        Decimal?
  floatVariance       Decimal?
  varianceReason      String?
  /// awaiting_receipt | confirmed | variance_open | resolved
  status              String   @default("awaiting_receipt")
  confirmedAt         DateTime?
  resolvedById        String?
  resolvedAt          DateTime?
  resolutionNote      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])
  shift  Shift           @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([tenantId, reference])
  @@index([shiftId, createdAt])
  @@index([tenantId, status])
  @@index([outgoingUserId])
  @@index([incomingUserId])
}

/// Deterministic operational finding produced by a named threshold rule.
///
/// No probabilistic or AI classification is used. Each finding carries the
/// rule, the measured value, the threshold and the supporting record so an
/// administrator can check it. The unique fingerprint prevents a repeated scan
/// from duplicating the same finding.
model OperationalAnomaly {
  id              String   @id @default(cuid())
  tenantId        String?
  fingerprint     String
  /// daily_shortage | daily_overage | repeated_shortage | unreviewed_account |
  /// missing_account | large_transaction | repeated_reversal | expense_spike |
  /// transfer_variance | stale_transfer | shift_variance |
  /// repeated_shift_variance | unconfirmed_handover
  ruleKey         String
  /// high | medium | low
  severity        String
  /// open | acknowledged | resolved
  status          String   @default("open")
  title           String
  summary         String
  entityType      String
  entityId        String
  locationId      String?
  workerId        String?
  businessDate    DateTime?
  metricValue     Decimal?
  thresholdValue  Decimal?
  evidence        String?
  detectedAt      DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  acknowledgedById String?
  acknowledgedAt  DateTime?
  resolvedById    String?
  resolvedAt      DateTime?
  resolutionNote  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, fingerprint])
  @@index([tenantId, status, severity])
  @@index([tenantId, ruleKey])
  @@index([tenantId, businessDate])
  @@index([locationId])
  @@index([workerId])
}

model Expense {
  id             String   @id @default(cuid())
  tenantId       String?
  dailyAccountId String
  description    String
  amount         Decimal
  createdAt      DateTime @default(now())

  dailyAccount DailyAccount @relation(fields: [dailyAccountId], references: [id], onDelete: Cascade)

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([dailyAccountId])
  @@index([tenantId])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String
  /// Snapshot of the actor at the time of the action. A later rename or
  /// removal must not rewrite who performed the historical action.
  actorName  String?
  actorRole  String?
  /// user | customer | system
  actorType  String?
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([tenantId])
}

// =====================
// SUSU MODULE
// =====================

model Customer {
  id           String   @id @default(cuid())
  tenantId     String?
  customerId   String   @unique // BIK-C-XXXXXX format, human-readable
  fullName     String
  phone        String?
  email        String?  @unique
  address      String?
  status       String   @default("active") // active | inactive
  registeredAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Customer Portal
  portalEnabled            Boolean   @default(false)
  portalPasswordHash       String?
  forcePortalPasswordReset Boolean   @default(false)
  passwordPolicyVersion    Int       @default(0)
  tokenVersion             Int       @default(0) // Bumped to invalidate existing customer sessions
  mfaEnabled               Boolean   @default(false)
  mfaSecret                String? // AES-256-GCM encrypted TOTP secret
  mfaRecoveryCodes   String? // Legacy JSON array (migrated to MfaRecoveryCode rows)
  mfaPendingSecretAt DateTime? // SEC-15: pending TOTP secret issued at this time
  mfaEnrolledAt            DateTime?
  mfaLastUsedAt            DateTime?
  mfaLastTotpStep          Int? // Last accepted TOTP step (replay prevention)

  accounts    SusuAccount[]
  assignments CollectorCustomerAssignment[]
  disputes    CustomerDispute[]
  messagingPreference CustomerMessagingPreference?
  customerMessages    CustomerMessageOutbox[]

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([status])
  @@index([customerId])
  @@index([phone])
  @@index([email])
  @@index([tenantId])
}

model SusuAccount {
  id                String   @id @default(cuid())
  tenantId          String?
  accountId         String   @unique // BIK-S-XXXXXX card number
  customerId        String
  dailyContribution Decimal // Customer's chosen daily contribution amount
  status            String   @default("active") // active | inactive | closed
  cardCustody       String   @default("customer") // customer | company | collector
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer      Customer                      @relation(fields: [customerId], references: [id])
  cycles        SusuCycle[]
  contributions Contribution[]
  withdrawals   Withdrawal[]
  commissions   Commission[]
  cardFees      CardFee[]
  assignments   CollectorCustomerAssignment[]
  disputes      CustomerDispute[]

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([customerId])
  @@index([accountId])
  @@index([status])
  @@index([tenantId])
}

model SusuCycle {
  id                String   @id @default(cuid())
  tenantId          String?
  accountId         String
  cycleNumber       Int // 1, 2, 3, ... per account
  startDate         DateTime
  endDate           DateTime
  dailyContribution Decimal // Snapshot of contribution at cycle start
  status            String   @default("active") // active | completed
  commissionCharged Boolean  @default(false) // Has first withdrawal commission been charged this cycle?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  account       SusuAccount    @relation(fields: [accountId], references: [id])
  contributions Contribution[]
  withdrawals   Withdrawal[]
  commissions   Commission[]

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@unique([accountId, cycleNumber])
  @@index([accountId])
  @@index([status])
  @@index([startDate])
  @@index([tenantId])
}

/// A customer's dispute about one recorded contribution or withdrawal.
///
/// The dispute is a review record, not a money movement. Resolving it never
/// edits or reverses the financial row silently; an upheld outcome must be
/// carried out through the existing correction/reversal control and referenced
/// in `outcomeReference`.
model CustomerDispute {
  id               String   @id @default(cuid())
  tenantId         String?
  reference        String
  customerId       String
  accountId        String?
  /// contribution | withdrawal
  subjectType      String
  subjectId        String
  /// Snapshot of the transaction reference at the time of the dispute.
  subjectReference String
  subjectAmount    Decimal
  /// Cycle number snapshotted when the dispute is opened.
  cycleNumber      Int?
  /// not_received | wrong_amount | duplicate_charge | unauthorised | other
  category         String
  details          String
  /// Receipt, statement line or other evidence reference supplied by the customer.
  customerEvidence String?
  /// Evidence reference recorded by the administrator at resolution.
  resolutionEvidence String?
  /// open | under_review | awaiting_customer | resolved_upheld |
  /// resolved_declined | cancelled
  status           String   @default("open")
  openedByType     String   @default("customer")
  openedById       String
  resolutionNote   String?
  resolutionById   String?
  resolvedAt       DateTime?
  /// Optional correction/reversal reference recorded when an outcome is upheld.
  outcomeReference String?
  createdAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant   BusinessTenant? @relation(fields: [tenantId], references: [id])
  customer Customer        @relation(fields: [customerId], references: [id])
  account  SusuAccount?    @relation(fields: [accountId], references: [id])
  events   CustomerDisputeEvent[]

  @@unique([tenantId, reference])
  @@unique([tenantId, subjectType, subjectId])
  @@index([tenantId, status])
  @@index([customerId, createdAt])
  @@index([accountId])
}

model CustomerDisputeEvent {
  id        String   @id @default(cuid())
  tenantId  String?
  disputeId String
  /// customer | admin | system
  actorType String
  actorId   String?
  action    String
  note      String?
  createdAt DateTime @default(now())

  tenant  BusinessTenant? @relation(fields: [tenantId], references: [id])
  dispute CustomerDispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId, createdAt])
  @@index([tenantId, createdAt])
}

model Contribution {
  id             String    @id @default(cuid())
  tenantId       String?
  accountId      String
  cycleId        String
  amount         Decimal // Total amount collected in this event
  collectionDate DateTime
  channel        String // collector | direct_office
  collectorId    String? // Reference to Collector if collected via collector
  recordedById   String // User who recorded the payment
  receivedById   String? // Staff (User) who recorded/authorised the office payment (audit)
  receivedByName String? // Free-text name of the staff who physically received the money
  recordedByName String? // Free-text name of the person who recorded the payment (display)
  /// Enrolled device that submitted an offline collection. Null for online
  /// office/collector recording, which is attributed to the authenticated user.
  recordedDeviceId   String?
  recordedDeviceName String?
  referenceId    String    @unique // Idempotency key - prevents duplicate submissions
  notes          String?
  createdAt      DateTime  @default(now())
  reversedAt     DateTime?
  reversalOfId   String?   @unique // Original record when this row is a reversal

  account     SusuAccount              @relation(fields: [accountId], references: [id])
  cycle       SusuCycle                @relation(fields: [cycleId], references: [id])
  collector   Collector?               @relation(fields: [collectorId], references: [id])
  recordedBy  User                     @relation("RecordedContributions", fields: [recordedById], references: [id])
  receivedBy  User?                    @relation("ReceivedContributions", fields: [receivedById], references: [id])
  allocations ContributionAllocation[]

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([accountId])
  @@index([cycleId])
  @@index([collectionDate])
  @@index([channel])
  @@index([collectorId])
  @@index([receivedById])
  @@index([referenceId])
  @@index([tenantId])
}

model ContributionAllocation {
  id             String   @id @default(cuid())
  tenantId       String?
  contributionId String
  cycleDay       Int // Which day in the cycle (1-31) this allocation covers
  amount         Decimal // Amount allocated to this day
  createdAt      DateTime @default(now())

  contribution Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([contributionId])
  @@index([cycleDay])
  @@index([tenantId])
}

model Withdrawal {
  id               String    @id @default(cuid())
  tenantId         String?
  accountId        String
  cycleId          String
  requestedAmount  Decimal // What the customer asked to withdraw
  commissionAmount Decimal   @default(0) // Commission deducted (one-day contribution if first withdrawal)
  netAmount        Decimal // Amount actually paid to customer
  remainingBalance Decimal // Balance left after withdrawal
  status           String    @default("completed") // completed | pending | rejected
  authorizedById   String // Admin who authorized
  referenceId      String    @unique // Idempotency key
  notes            String?
  createdAt        DateTime  @default(now())
  reversedAt       DateTime?
  reversalOfId     String?   @unique // Original record when this row is a reversal

  account SusuAccount @relation(fields: [accountId], references: [id])
  cycle   SusuCycle   @relation(fields: [cycleId], references: [id])

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([accountId])
  @@index([cycleId])
  @@index([createdAt])
  @@index([referenceId])
  @@index([tenantId])
}

model Commission {
  id           String   @id @default(cuid())
  tenantId     String?
  accountId    String
  cycleId      String
  amount       Decimal // Equals one day's contribution
  basis        String // "one_day_contribution"
  triggeredBy  String // "first_withdrawal"
  recordedById String
  createdAt    DateTime @default(now())

  account SusuAccount @relation(fields: [accountId], references: [id])
  cycle   SusuCycle   @relation(fields: [cycleId], references: [id])

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([accountId])
  @@index([cycleId])
  @@index([tenantId])
}

model CardFee {
  id           String   @id @default(cuid())
  tenantId     String?
  accountId    String
  amount       Decimal  @default(10) // GH₵10 card fee
  recordedById String
  notes        String?
  createdAt    DateTime @default(now())

  account SusuAccount @relation(fields: [accountId], references: [id])

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([accountId])
  @@index([tenantId])
}

model Collector {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String   @unique
  status    String   @default("active") // active | inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User                          @relation(fields: [userId], references: [id])
  assignments   CollectorCustomerAssignment[]
  contributions Contribution[]
  remittances   CollectorRemittance[]

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([status])
  @@index([tenantId])
}

model CollectorCustomerAssignment {
  id           String    @id @default(cuid())
  tenantId     String?
  collectorId  String
  customerId   String
  accountId    String
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?
  active       Boolean   @default(true)

  collector Collector   @relation(fields: [collectorId], references: [id])
  customer  Customer    @relation(fields: [customerId], references: [id])
  account   SusuAccount @relation(fields: [accountId], references: [id])

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@unique([collectorId, accountId])
  @@index([collectorId])
  @@index([customerId])
  @@index([accountId])
  @@index([tenantId])
}

model CollectorRemittance {
  id             String    @id @default(cuid())
  tenantId       String?
  collectorId    String
  expectedAmount Decimal // Sum of recorded collections
  remittedAmount Decimal // Amount physically brought to office
  variance       Decimal // expected - remitted
  status         String    @default("pending") // pending | reconciled | discrepancy
  recordedById   String // Admin who recorded
  referenceId    String    @unique // Server-issued reference shown in reports
  // SEC-06: client idempotency key scoped to the tenant. Retries with the same
  // key return the original row; reuse with different parameters is rejected.
  idempotencyKey String?
  requestHash    String?
  notes          String?
  reversedAt     DateTime?
  reversedById   String?
  reversalReason String?
  createdAt      DateTime  @default(now())

  collector Collector @relation(fields: [collectorId], references: [id])

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([collectorId])
  @@index([status])
  @@index([createdAt])
  @@index([referenceId])
  @@index([tenantId])
  @@unique([tenantId, idempotencyKey])
}

/// Immutable snapshot of a daily account before an administrative correction.
/// The live DailyAccount row carries the corrected figures; this table preserves
/// the exact prior values, reason, author and version so history is auditable.
model DailyAccountRevision {
  id             String   @id @default(cuid())
  tenantId       String?
  dailyAccountId String
  version        Int
  snapshot       String // JSON of the financial fields and expenses before correction
  reason         String
  correctedById  String
  createdAt      DateTime @default(now())

  dailyAccount DailyAccount @relation(fields: [dailyAccountId], references: [id], onDelete: Cascade)

  @@unique([dailyAccountId, version])
  @@index([dailyAccountId])
  @@index([tenantId])
  @@index([createdAt])
}

// =====================
// PASSWORD RECOVERY
// =====================

model EmailVerificationToken {
  id        String    @id @default(cuid())
  tenantId  String?
  userId    String
  tokenHash String    @unique // SHA-256 hash of the raw token - never store raw token
  // SEC-14: hash of the normalized destination address this token was issued
  // for. Verification refuses when it differs from the account's current
  // normalized address. Null on legacy rows, which are invalidated.
  destinationEmailHash String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([tenantId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tenantId  String?
  userId    String
  tokenHash String    @unique // SHA-256 hash of the raw token — never store raw token
  expiresAt DateTime // Token expires after 15 minutes
  usedAt    DateTime? // Null until successfully used
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([tenantId])
}

// =====================
// OFFLINE / DEVICE ENROLLMENT
// =====================

model DeviceEnrollment {
  id           String    @id @default(cuid())
  tenantId     String?
  userId       String
  deviceId     String    @unique // Client-generated unique device identifier
  deviceName   String? // Human-readable device label
  module       String // "momo" | "susu"
  status       String    @default("active") // active | revoked
  lastSyncAt   DateTime?
  authorizedAt DateTime  @default(now()) // When last authorized (for offline timeout)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([deviceId])
  @@index([status])
  @@index([tenantId])
}

model OfflineTransaction {
  id             String    @id @default(cuid())
  tenantId       String?
  deviceId       String
  userId         String
  type           String // "contribution" | "daily_account_draft"
  idempotencyKey String    @unique // deviceId + UUID — server dedup key
  payload        String // JSON-encrypted transaction data
  status         String    @default("pending_sync") // pending_sync | syncing | synced | failed
  retryCount     Int       @default(0)
  maxRetries     Int       @default(5)
  failureReason  String?
  serverResult   String? // JSON server response after sync
  localTimestamp DateTime  @default(now()) // When created on device
  syncStartedAt  DateTime?
  syncedAt       DateTime? // When server confirmed
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([deviceId])
  @@index([userId])
  @@index([idempotencyKey])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([tenantId])
}

// =====================
// PLATFORM / MULTI-TENANCY
// =====================

/// A single enrolled business on the platform. Every tenant-owned record
/// carries a tenantId pointing here; all tenant data access resolves this
/// record from the authenticated server session (never from browser input).
/// A member of an association (for example a MoMo agents' association).
/// Records are tenant-scoped and do not grant access to another business.
model AssociationMember {
  id            String    @id @default(cuid())
  tenantId      String?
  memberCode    String
  businessName  String
  contactName   String
  phone         String?
  email         String?
  region        String?
  /// invited | active | suspended | withdrawn
  status        String    @default("active")
  joinedAt      DateTime?
  notes         String?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant      BusinessTenant?            @relation(fields: [tenantId], references: [id])
  sponsorships AssociationSponsorship[]
  trainings    AssociationTrainingRecord[]

  @@unique([tenantId, memberCode])
  @@unique([tenantId, phone])
  @@index([tenantId, status])
  @@index([tenantId, businessName])
}

/// Sponsorship of one association member. This is a record of an agreed
/// sponsorship only. It never charges, pays out or changes a subscription.
model AssociationSponsorship {
  id           String    @id @default(cuid())
  tenantId     String?
  memberId     String
  sponsorName  String
  planCode     String?
  amount       Decimal   @default(0)
  currency     String    @default("GHS")
  /// pledged | active | ended | cancelled
  status       String    @default("pledged")
  startDate    DateTime?
  endDate      DateTime?
  reference    String?
  notes        String?
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])
  member AssociationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@index([memberId, createdAt])
}

/// Training completed or scheduled by an association member.
model AssociationTrainingRecord {
  id                   String    @id @default(cuid())
  tenantId             String?
  memberId             String
  title                String
  provider             String?
  /// scheduled | completed | expired | cancelled
  status               String    @default("completed")
  completedAt          DateTime?
  expiresAt            DateTime?
  certificateReference String?
  notes                String?
  createdById          String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])
  member AssociationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([memberId, completedAt])
}

model BusinessTenant {
  id                 String    @id @default(cuid())
  code               String    @unique // server-generated, e.g. BIK-A1B2C3
  name               String
  legalName          String?
  contactPhone       String?
  contactEmail       String?
  address            String?
  momoEnabled        Boolean   @default(false)
  susuEnabled        Boolean   @default(false)
  status             String    @default("PROVISIONING") // PROVISIONING | ACTIVE | SUSPENDED | ARCHIVED
  onboardingStatus   String    @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | COMPLETED
  primaryAdminUserId String?
  activatedAt        DateTime?
  suspendedAt        DateTime?
  suspensionReason   String?
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  users                        User[]
  locations                    Location[]
  dailyAccounts                DailyAccount[]
  momoTransactions             MomoTransaction[]
  branchAssetBalances          BranchAssetBalance[]
  branchTransfers              BranchTransfer[]
  shifts                       Shift[]
  shiftHandovers               ShiftHandover[]
  shiftRevisions               ShiftRevision[]
  operationalPolicy            TenantOperationalPolicy?
  operationalAnomalies         OperationalAnomaly[]
  customerDisputes             CustomerDispute[]
  customerDisputeEvents        CustomerDisputeEvent[]
  associationMembers           AssociationMember[]
  associationSponsorships      AssociationSponsorship[]
  associationTrainingRecords   AssociationTrainingRecord[]
  customerMessagingPreferences CustomerMessagingPreference[]
  customerMessages             CustomerMessageOutbox[]
  expenses                     Expense[]
  auditLogs                    AuditLog[]
  customers                    Customer[]
  susuAccounts                 SusuAccount[]
  susuCycles                   SusuCycle[]
  contributions                Contribution[]
  contributionAllocations      ContributionAllocation[]
  withdrawals                  Withdrawal[]
  commissions                  Commission[]
  cardFees                     CardFee[]
  collectors                   Collector[]
  collectorCustomerAssignments CollectorCustomerAssignment[]
  collectorRemittances         CollectorRemittance[]
  passwordResetTokens          PasswordResetToken[]
  deviceEnrollments            DeviceEnrollment[]
  offlineTransactions          OfflineTransaction[]
  zeliEntitlements             ZeliEntitlement[]
  zeliAccess                   ZeliTenantAccess?
  zeliAnalyticsDaily           ZeliAnalyticsDaily[]
  zeliAnalyticsRefreshes       ZeliAnalyticsRefresh[]
  zeliSubscriptions            ZeliSubscription[]
  foundingAllocation           FoundingAllocation?
  notifications                TenantNotification[]
  enquiries                    AccountEnquiry[]
  zeliPaymentEvents            ZeliPaymentEvent[]
  zeliAiAuthorizations         ZeliAiTenantAuthorization[]
  zeliEntitlementEvents        ZeliEntitlementEvent[]
  providerStatementImports      ProviderStatementImport[]
  providerStatementRows         ProviderStatementRow[]
  branchLiquiditySnapshots      BranchLiquiditySnapshot[]
  branchLiquidityLines          BranchLiquidityLine[]
  reconciliationCases           ReconciliationExceptionCase[]
  reconciliationCaseLinks       ReconciliationExceptionLink[]
  reconciliationCaseEvents      ReconciliationExceptionEvent[]

  @@index([status])
  @@index([onboardingStatus])
  @@index([momoEnabled])
  @@index([susuEnabled])
}

/// Platform operator identity (BloomCore). Completely separate from tenant
/// User accounts: own table, own cookie, own guard. Never a tenant admin.
model PlatformSuperAdmin {
  id                 String    @id @default(cuid())
  email              String    @unique
  fullName           String
  passwordHash       String
  status             String    @default("active") // active | inactive
  forcePasswordReset Boolean   @default(false)
  passwordPolicyVersion Int    @default(0)
  tokenVersion       Int       @default(0)
  mfaEnabled         Boolean   @default(false)
  mfaSecret          String? // AES-256-GCM encrypted TOTP secret
  mfaRecoveryCodes   String? // Legacy JSON array (migrated to MfaRecoveryCode rows)
  mfaPendingSecretAt DateTime? // SEC-15: pending TOTP secret issued at this time
  mfaEnrolledAt      DateTime?
  mfaLastUsedAt      DateTime?
  mfaLastTotpStep    Int? // Last accepted TOTP step (replay prevention)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  auditLogs PlatformAuditLog[]
  oidcLinks PlatformOidcLink[]

  @@index([status])
}

/// OIDC identity link between a BloomCore Identity (Control Center / Authentik)
/// subject and a platform super administrator. Feature-flagged SSO; the link is
/// only created after the Control Center reports `verified`, or after the
/// administrator proves the CURRENT local password (pending path). One IdP
/// subject maps to at most one platform administrator and vice versa.
model PlatformOidcLink {
  id              String   @id @default(cuid())
  platformAdminId String
  issuer          String // exact OIDC issuer
  idpSub          String   @unique // `sub` claim from the IdP
  linkedVia       String // "cc_verified" | "local_credential_proof"
  createdBy       String? // platform admin id that completed a pending confirmation
  linkedAt        DateTime @default(now())

  platformAdmin PlatformSuperAdmin @relation(fields: [platformAdminId], references: [id])

  @@unique([issuer, platformAdminId])
  @@index([platformAdminId])
}

/// Server-side companion to a platform SessionRecord created through SSO.
/// Holds the (encrypted) IdP refresh token so logout can revoke it centrally.
/// Tokens never live in cookies; the row is deleted on logout.
model PlatformOidcSession {
  id              String   @id // SessionRecord jti
  platformAdminId String
  refreshTokenEnc String? // AES-256-GCM encrypted IdP refresh token
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@index([platformAdminId])
  @@index([expiresAt])
}

/// Platform-level audit trail. Deliberately isolated from tenant AuditLog so
/// the two security boundaries never mix. tenantId is a plain string (not a
/// relation) so platform history survives tenant archival.
model PlatformAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  tenantId   String?
  tenantCode String?
  entityType String?
  entityId   String?
  details    String?
  reason     String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor PlatformSuperAdmin? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([tenantId])
  @@index([createdAt])
}

// =====================
// SECURITY CONTROLS
// =====================
// Persistent, database-backed abuse controls. These tables hold keyed HMAC
// identifiers only — never raw email addresses, IP addresses or tokens.

/// Fixed-window request counter shared by every application instance.
model RateLimitCounter {
  id              String   @id @default(cuid())
  key             String   @unique // "<bucket>:<hmac>"
  count           Int      @default(0)
  windowStartedAt DateTime
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
}

/// Progressive failed-login state (1 min → 5 min → 15 min cooldowns).
model AuthThrottle {
  id              String    @id @default(cuid())
  key             String    @unique // "<scope>:<hmac>"
  failedCount     Int       @default(0)
  stage           Int       @default(0)
  windowStartedAt DateTime
  lastFailedAt    DateTime
  blockedUntil    DateTime?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([expiresAt])
  @@index([blockedUntil])
}

/// Single-use ledger for Cloudflare Turnstile tokens (replay protection).
model TurnstileTokenUse {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  usedAt    DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

/// Server-side session registry. A JWT is only accepted while its `jti` row
/// exists, is unexpired and has not been revoked.
/// Per-tab proof-of-possession credential. The private key never leaves the
/// browser; only the public JWK is stored. A credential is bound to exactly one
/// server-side SessionRecord.
model TabCredential {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  subjectType   String
  subjectId     String
  tenantId      String?
  module        String
  amr           String
  payloadJson   String
  publicKeyJwk  String
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime @default(now())

  @@index([subjectType, subjectId])
}

/// One-time proof nonces. The primary key is the nonce, so a replayed request
/// is rejected even across instances.
model TabProofNonce {
  id           String   @id
  credentialId String
  requestId    String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
}

/// One-time proof that an MFA challenge was actually completed.
/// The row id is the signed challenge jti; a unique primary key makes replay
/// impossible even across concurrent requests or server instances.
model MfaChallengeUse {
  id          String    @id
  purpose     String // verified | enrolled
  subjectType String // user | customer | platform
  subjectId   String
  createdAt   DateTime  @default(now())
  consumedAt  DateTime?
  expiresAt   DateTime

  @@index([expiresAt])
}

model SessionRecord {
  id            String    @id // JWT `jti`
  subjectType   String // user | customer | platform
  subjectId     String
  tenantId      String?
  ipHash        String?
  userAgentHash String?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  // Provenance (Phase 1.1). Local logins leave these null; SSO sessions carry
  // the immutable Authentik subject and OIDC session id so central logout and
  // IdP back-channel logout revoke exactly these rows and never a local login.
  authSource    String?
  idpSub        String?
  idpSid        String?

  @@index([subjectType, subjectId])
  @@index([expiresAt])
  @@index([idpSub])
  @@index([idpSid])
}

/// Processed revocation message ids (replay/duplicate protection).
model OidcRevocationEvent {
  eventId    String   @id
  source     String   @default("control_center")
  receivedAt DateTime @default(now())
}

/// Administrator-issued, single-use account recovery code.
/// Only the hash is stored; the plaintext code is shown once to the issuing
/// administrator and is never returned by any read/API path.
model AccountRecoveryRequest {
  id              String    @id @default(cuid())
  tenantId        String?
  targetType      String // user | customer
  targetId        String
  requestedById   String
  requestedByType String // platform | user
  reason          String
  codeHash        String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([tenantId])
  @@index([targetType, targetId])
  @@index([expiresAt])
}

// =====================
// ZELI ASSISTANT
// =====================

/// A private assistant conversation. Ownership is tenant + authenticated user;
/// no cross-tenant or cross-user lookup is permitted.
model ZeliConversation {
  id        String        @id @default(cuid())
  tenantId  String?
  userId    String
  userType  String        @default("user") // user | customer | platform
  title     String        @default("New conversation")
  /// auto | manual. A manual rename is never overwritten by title generation.
  titleSource String      @default("auto")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  messages  ZeliMessage[]

  @@index([tenantId, userId, updatedAt])
  @@index([deletedAt])
}

model ZeliMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user | assistant
  content        String
  sources        String? // JSON array of {label, href?, detail?}
  toolCalls      String? // JSON metadata: tool name, outcome, duration
  provider       String?
  model          String?
  feedback       String? // helpful | unhelpful
  createdAt      DateTime @default(now())

  conversation ZeliConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([feedback])
}

/// Per-user daily request budget. Enforced server-side; no client trust.
model ZeliUsage {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String
  day       String // YYYY-MM-DD (UTC)
  requests  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId, day])
  @@index([day])
}

// =====================
// ZELI BUSINESS INTELLIGENCE
// =====================

/// A tenant's Zeli Business Intelligence entitlement. This is the single
/// subscription/entitlement record for the product feature: there is no second
/// billing architecture. Platform administrators manage it with an audited,
/// reason-bearing workflow; tenant administrators can read access but cannot
/// grant it to themselves.
/// Per-business Zeli switch controlled by Platform Super Admin. The absence of
/// a row means Zeli is enabled for the business while the global switch is on.
model ZeliTenantAccess {
  tenantId    String   @id
  enabled     Boolean  @default(true)
  reason      String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant BusinessTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ZeliEntitlement {
  id            String    @id @default(cuid())
  tenantId      String
  featureKey    String    @default("zeli_analytics")
  status        String    @default("active") // active | suspended | revoked
  source        String    @default("manual") // manual | subscription
  reason        String?
  startsAt      DateTime  @default(now())
  expiresAt     DateTime?
  grantedById   String?
  grantedByType String? // platform
  suspendedAt   DateTime?
  revokedAt     DateTime?
  revokedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant BusinessTenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events ZeliEntitlementEvent[]

  @@unique([tenantId, featureKey])
  @@index([tenantId])
  @@index([status])
  @@index([expiresAt])
}

/// Append-only entitlement history. Every grant, suspension, revocation,
/// reactivation and expiry sweep is recorded with a mandatory reason.
model ZeliEntitlementEvent {
  id             String    @id @default(cuid())
  entitlementId  String?
  tenantId       String
  featureKey     String    @default("zeli_analytics")
  action         String // granted | activated | suspended | revoked | expired
  previousStatus String?
  status         String
  reason         String
  actorId        String?
  actorType      String // platform | system
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  entitlement ZeliEntitlement? @relation(fields: [entitlementId], references: [id], onDelete: SetNull)
  tenant      BusinessTenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([entitlementId, createdAt])
}

/// Tenant-scoped daily analytics aggregate. Rows are derived from authoritative
/// financial records and are rebuilt for a requested range, never edited by a
/// browser. The unique key makes repeated refresh idempotent: a duplicate event
/// updates the same row instead of double-counting.
model ZeliAnalyticsDaily {
  id                 String   @id @default(cuid())
  tenantId           String
  businessDate       String // YYYY-MM-DD (UTC bucket)
  scope              String   @default("all") // "all" or a location id
  contributions      Decimal  @default(0)
  contributionCount  Int      @default(0)
  withdrawals        Decimal  @default(0)
  withdrawalCount    Int      @default(0)
  commissions        Decimal  @default(0)
  remittances        Decimal  @default(0)
  remittanceVariance Decimal  @default(0)
  remittanceCount    Int      @default(0)
  expenses           Decimal  @default(0)
  expenseCount       Int      @default(0)
  cashIncome         Decimal  @default(0)
  transactionCount   Int      @default(0)
  activeCustomers    Int      @default(0)
  newCustomers       Int      @default(0)
  refreshedAt        DateTime @default(now())

  tenant BusinessTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scope, businessDate])
  @@index([tenantId, businessDate])
  @@index([tenantId, scope, businessDate])
}

/// Refresh bookkeeping for a tenant/scope/range. Used for freshness labels,
/// retry visibility and operational health. It stores no financial values.
model ZeliAnalyticsRefresh {
  id          String   @id @default(cuid())
  tenantId    String
  scope       String   @default("all")
  rangeStart  String
  rangeEnd    String
  status      String   @default("ok") // ok | failed
  rowCount    Int      @default(0)
  durationMs  Int      @default(0)
  error       String?
  refreshedAt DateTime @default(now())

  tenant BusinessTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scope, rangeStart, rangeEnd])
  @@index([tenantId, refreshedAt])
}

/// Privacy gateway decision log. It records that a payload was allowed or
/// denied and why, with only allow-list category names and counts. It never
/// stores payload values, customer records or prompts.
model ZeliProviderGatewayEvent {
  id                   String   @id @default(cuid())
  tenantId             String?
  provider             String
  decision             String // allowed | denied
  reason               String
  policyVersion        String
  payloadCategories    String? // JSON array of allow-listed metric names
  observationCount     Int?
  suppressedGroupCount Int?
  createdAt            DateTime @default(now())

  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@index([decision])
}

// =====================
// ZELI COMMERCE AND PROVIDER CONTROL
// =====================

/// Configurable Zeli subscription catalogue. Prices are owner-configured; no
/// price is seeded by the application.
model ZeliPlan {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  description      String?
  billingInterval  String // month | year
  price            Decimal
  currency         String   @default("GHS")
  features         String? // JSON array of feature labels
  usageAllowance   Int?
  trialDays        Int      @default(0)
  locationLimit    Int? // approved package: maximum business locations
  staffLimit       Int? // approved package: maximum staff accounts
  supportLevel     String? // approved package: support tier label
  /// Approved founding monthly price. Null when the plan is not eligible.
  foundingPrice    Decimal?
  /// Zeli is included in every commercial package.
  zeliIncluded     Boolean  @default(true)
  providerPlanCode String? // optional Paystack plan for recurring billing
  status           String   @default("draft") // draft | active | archived
  isPublic         Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdById      String?
  updatedById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscriptions        ZeliSubscription[]
  foundingAllocations  FoundingAllocation[]

  @@index([status])
  @@index([isPublic])
}

/// One commercial subscription attempt/lifecycle. The provider reference is
/// unique and is the idempotency anchor for webhooks and verification.
model ZeliSubscription {
  id                       String    @id @default(cuid())
  tenantId                 String
  planId                   String
  status                   String    @default("pending") // pending | active | past_due | cancelled | expired | refunded | failed
  provider                 String    @default("paystack")
  providerReference        String    @unique
  providerSubscriptionCode String?
  providerCustomerCode     String?
  amount                   Decimal
  currency                 String    @default("GHS")
  periodStart              DateTime?
  periodEnd                DateTime?
  cancelAtPeriodEnd        Boolean   @default(false)
  cancelledAt              DateTime?
  refundedAt               DateTime?
  paidAt                   DateTime?
  failureReason            String?
  /// monthly | annual. Annual billing never combines with the founding offer.
  billingTerm              String    @default("monthly")
  /// Founding slot used by this payment, when any. Consumed exactly once per
  /// paid period; the fourth renewal returns to the standard price.
  foundingAllocationId     String?
  /// Standard price that applies once a founding allocation is exhausted.
  standardAmount           Decimal?
  /// End of the five-calendar-day grace period after periodEnd.
  graceEndsAt              DateTime?
  /// Last reminder already delivered: 7 | 3 | 1 | 0 | grace.
  reminderStage            String?
  /// Package change requested by the owner. Applied by the next renewal
  /// payment; the already-paid period is never changed or prorated.
  scheduledPlanCode        String?
  scheduledBillingTerm     String?
  scheduledAt              DateTime?
  /// Set only while status = "pending". The unique index makes two concurrent
  /// checkouts for the same tenant and plan impossible.
  pendingKey               String?   @unique
  /// True only when this subscription actually extended the entitlement period.
  periodGranted            Boolean   @default(false)
  /// none | pending | processed | failed. A refund is never reported as
  /// processed before Paystack confirms it.
  refundStatus             String?
  refundReference          String?   @unique
  refundFailureReason      String?
  supersededByReference    String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  tenant BusinessTenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   ZeliPlan           @relation(fields: [planId], references: [id])
  events ZeliPaymentEvent[]

  @@index([tenantId, status])
  @@index([providerReference])
  @@index([periodEnd])
  @@index([refundStatus])
}

/// Provider webhook/verification ledger. eventId is unique so duplicate
/// webhooks cannot double-activate or double-charge. No raw payload is stored.
model ZeliPaymentEvent {
  id             String    @id @default(cuid())
  provider       String    @default("paystack")
  eventId        String    @unique
  eventType      String
  reference      String?
  subscriptionId String?
  tenantId       String?
  decision       String    @default("received") // processed | ignored | failed
  reason         String?
  createdAt      DateTime  @default(now())
  processedAt    DateTime?

  subscription ZeliSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  tenant       BusinessTenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([reference])
  @@index([tenantId, createdAt])
  @@index([decision])
}

/// A payment that could not be resolved automatically and needs a human
/// decision: a duplicate settlement, a failed automatic refund or a payment
/// that did not match its checkout. Never contains provider secrets.
model ZeliPaymentException {
  id             String    @id @default(cuid())
  /// Stable identity so repeated webhook deliveries cannot spam the queue.
  dedupeKey      String    @unique
  tenantId       String?
  subscriptionId String?
  reference      String?
  kind           String // duplicate_payment | refund_failed | payment_mismatch | processing_failure
  status         String    @default("open") // open | resolved
  amount         Decimal?
  currency       String?
  detail         String
  resolutionNote String?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([status, createdAt])
  @@index([tenantId, createdAt])
  @@index([reference])
}

/// One durable record per provider reference, used as the concurrency guard
/// that allows at most one in-flight Paystack charge for that reference.
///
/// The unique `reference` is the database-level claim: a second concurrent
/// request cannot create a row, so it can never reach the provider a second
/// time. A definite rejection may be retried on the same reference by an
/// atomic state transition; a pending, unresolved, successful or failed charge
/// may not be reused.
///
/// Never stores a mobile-money number, customer email, payload or secret.
model ZeliChargeAttempt {
  id                 String    @id @default(cuid())
  reference          String    @unique
  tenantId           String
  subscriptionId     String
  provider           String    @default("paystack")
  method             String    // mobile_money | hosted
  network            String?   // mtn | atl | vod
  /// Hosted checkout method bound at initialisation: mobile_money | card | bank_transfer.
  checkoutChannel    String?
  amount             Decimal
  currency           String
  /// initiating | pending | rejected | failed | unresolved | succeeded | abandoned
  state              String    @default("initiating")
  /// What the customer must supply while `state` is pending:
  /// otp | phone_prompt | offline | checkout | null. Never holds the code.
  requiredAction     String?
  /// Trusted Paystack authorization URL for a pending hosted checkout. It is a
  /// public checkout page, never a secret, and it lets a retry reopen the same
  /// transaction instead of initialising a second one.
  checkoutUrl        String?
  /// How many provider calls this reference has consumed (1 normally).
  attempts           Int       @default(1)
  providerHttpStatus Int?
  providerCode       String?
  /// Sanitized provider explanation or customer-safe instruction.
  reason             String?
  correlationId      String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  resolvedAt         DateTime?

  @@index([tenantId, state])
  @@index([subscriptionId])
  @@index([state, updatedAt])
}

/// Global external-AI control. A missing row means disabled + emergency on.
/// Production mode additionally requires reviewed code approval and
/// environment approvals; this row cannot enable it alone.
model ZeliProviderControl {
  id                String   @id @default("global")
  mode              String   @default("disabled") // disabled | synthetic | approved
  enabled           Boolean  @default(false)
  emergencyDisabled Boolean  @default(true)
  approvedProvider  String? // deepseek
  approvedPurposes  String? // JSON array
  policyVersion     String?
  approvalReference String?
  reason            String?
  updatedById       String?
  updatedAt         DateTime @updatedAt
}

/// Per-tenant authorization for approved aggregate-only production
/// processing. It has no effect while the global mode is disabled or the code
/// approval remains absent.
model ZeliAiTenantAuthorization {
  id           String    @id @default(cuid())
  tenantId     String    @unique
  enabled      Boolean   @default(false)
  reason       String
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant BusinessTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Privacy-safe provider audit/usage ledger. It stores decisions and token
/// counts, never prompts, payload values, responses or credentials.
model ZeliProviderUsage {
  id             String   @id @default(cuid())
  requestId      String   @unique
  tenantHash     String
  userHash       String
  roleCategory   String
  provider       String
  model          String
  purpose        String
  schemaVersion  String
  decision       String // allowed | denied | success | rejected | error
  reasonCategory String?
  latencyMs      Int?
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime @default(now())

  @@index([tenantHash, createdAt])
  @@index([userHash, createdAt])
  @@index([decision, createdAt])
  @@index([provider, createdAt])
}

/// Restricted external-AI team-testing access for one tenant member.
/// Scalar tenant/user references keep the table additive and independent; the
/// application re-checks tenant, role and status on every request.
model ZeliTeamTester {
  id                    String    @id @default(cuid())
  tenantId              String
  userId                String
  status                String    @default("active") // active | revoked
  disclosureVersion     String?
  disclosureAcceptedAt  DateTime?
  grantedById           String?
  revokedById           String?
  reason                String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([userId, status])
}

/// Entire-Zeli master switch. Separate from the external-AI provider control.
/// A missing row is treated as unavailable (fail closed); the migration inserts
/// an enabled row so existing installations preserve availability.
model ZeliAvailability {
  id          String   @id @default("global")
  enabled     Boolean  @default(true)
  reason      String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


// A2: tenant operational policy. One row per business, written only by an
// administrator and audited. Absent row = product defaults (shifts optional,
// no per-action actor proof).
model TenantOperationalPolicy {
  id                           String   @id @default(cuid())
  tenantId                     String   @unique
  /// When true a worker cannot submit a daily close without a closed shift for
  /// the same employee, branch and business day.
  shiftsRequired               Boolean  @default(false)
  /// When true the actor must prove identity again (their own password) before a
  /// sensitive count is submitted on a shared device: a shift count or a daily
  /// close. The proof is a single-use step-up grant bound to that record.
  actorProofForSensitiveCounts Boolean  @default(false)
  note                         String?
  updatedById                  String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  tenant BusinessTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// A2: audited revision of a closed shift. The original figures are preserved in
// this revision's snapshot; a shift is never silently rewritten.
model ShiftRevision {
  id            String    @id @default(cuid())
  tenantId      String?
  shiftId       String
  /// JSON snapshot of the shift figures before the revision.
  beforeJson    String
  /// JSON snapshot of the shift figures after the revision.
  afterJson     String
  /// cash | momo_float | both
  fields        String
  reason        String
  requestedById String
  approvedById  String
  createdAt     DateTime  @default(now())

  shift  Shift          @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, shiftId])
  @@index([shiftId, createdAt])
}

// SEC-04: server-side, single-use step-up authorization grant.
// Only a SHA-256 hash of the opaque bearer token is stored.
model StepUpGrant {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  subjectType String // user | platform
  subjectId   String
  sessionId   String // JWT jti / SessionRecord.id the grant is bound to
  purpose     String
  targetType  String?
  targetId    String?
  contextHash String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?
  revokedAt   DateTime?

  @@index([sessionId])
  @@index([subjectType, subjectId])
  @@index([expiresAt])
}

// SEC-07: one hashed MFA recovery code per row so consumption is a single
// conditional mutation. Subject existence and type are validated in code.
model MfaRecoveryCode {
  id          String    @id @default(cuid())
  subjectType String // user | platform | customer
  subjectId   String
  codeHash    String
  createdAt   DateTime  @default(now())
  usedAt      DateTime?

  @@unique([subjectType, subjectId, codeHash])
  @@index([subjectType, subjectId])
  @@index([createdAt])
}

// Residual C: persisted security events with a 365-day retention window.
// Financial and business audit history lives in AuditLog / PlatformAuditLog and
// is never touched by security-event retention or its cleanup job.
model SecurityEventRecord {
  id        String   @id @default(cuid())
  event     String
  outcome   String
  severity  String   @default("info") // info | warning | critical
  actorType String?
  actorId   String?
  tenantId  String?
  ipHash    String?
  route     String?
  reason    String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([severity, createdAt])
  @@index([tenantId, createdAt])
  @@index([event, createdAt])
}

// Residual C: durable in-app security alerts. Critical alerts also go out
// through the existing Resend transactional-email path.
model SecurityAlert {
  id          String    @id @default(cuid())
  tenantId    String?
  audience    String // platform | tenant_admin | subject
  subjectType String?
  subjectId   String?
  severity    String // warning | critical
  event       String
  title       String
  body        String
  dedupeKey   String?   @unique
  emailStatus String? // sent | failed | skipped
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([audience, createdAt])
  @@index([tenantId, createdAt])
  @@index([severity, createdAt])
}

// Residual D: second-person approval for high-impact platform operations when
// more than one authorized platform administrator exists.
model PlatformApprovalRequest {
  id          String    @id @default(cuid())
  action      String
  targetType  String
  targetId    String
  reason      String
  requestedBy String
  status      String    @default("pending") // pending | approved | rejected | expired
  approvedBy  String?
  decidedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

// Residual E: maker-checker control for sensitive financial operations.
// `exceptionUsed` records the approved single-administrator exception.
model FinancialApproval {
  id            String    @id @default(cuid())
  tenantId      String
  action        String
  targetType    String
  targetId      String
  amountMinor   Int?
  reason        String
  requestedBy   String
  status        String    @default("pending") // pending | approved | rejected | consumed | expired
  approvedBy    String?
  exceptionUsed Boolean   @default(false)
  decidedAt     DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  @@index([tenantId, status, createdAt])
  @@index([action, targetId])
}

model AccountEnquiry {
  id              String   @id @default(cuid())
  businessName    String
  contactName     String
  phone           String
  email           String?
  locationCount   Int?
  interestedPlan  String?
  message         String?
  status          String   @default("new") // new | contacted | qualified | provisioned | converted | rejected
  /// DEMO_REQUEST (demonstration form) or ACCOUNT_REQUEST (pricing page).
  enquiryType     String   @default("ACCOUNT_REQUEST")
  /// What the business wants to manage: momo | susu | both.
  modules         String?
  source          String?
  notes           String?
  reviewedById    String?
  reviewedAt      DateTime?
  /// Set when Platform Super Admin provisions the business from this enquiry.
  tenantId        String?
  convertedAt     DateTime?
  assignedPlanCode String?
  billingTerm     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([enquiryType, createdAt])
  @@index([createdAt])
  @@index([tenantId])
}

/// One of the five approved founding-customer slots. Assignment is atomic
/// (unique slot number) and audited by Platform Super Admin. A slot grants the
/// founding monthly price for three consecutive paid monthly periods only.
model FoundingAllocation {
  id             String    @id @default(cuid())
  tenantId       String    @unique
  planId         String
  /// 1..5. The unique index is the concurrency guard for the five-slot cap.
  slot           Int       @unique
  monthlyPrice   Decimal
  standardPrice  Decimal
  periodsGranted Int       @default(3)
  periodsUsed    Int       @default(0)
  status         String    @default("active") // active | exhausted | revoked
  assignedById   String?
  assignedAt     DateTime  @default(now())
  revokedById    String?
  revokedAt      DateTime?
  revokeReason   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant BusinessTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   ZeliPlan       @relation(fields: [planId], references: [id])

  @@index([status])
}

/// Durable in-app notification. `kind` separates verified system events from
/// AI-generated business insights; `dedupeKey` prevents repetitive entries.
model TenantNotification {
  id         String    @id @default(cuid())
  tenantId   String?
  /// tenant | platform
  audience   String    @default("tenant")
  /// system | insight
  kind       String    @default("system")
  /// critical | attention | info
  severity   String    @default("info")
  title      String
  body       String
  href       String?
  dedupeKey  String    @unique
  readAt     DateTime?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([audience, createdAt])
  @@index([resolvedAt])
}

/// Durable outbox for internal platform email. `eventKey` is unique, so a
/// repeated webhook, status check or retry can never send a second message.
/// `payload` holds the already-computed, non-secret message fields only.
model PlatformEmailOutbox {
  id          String    @id @default(cuid())
  eventKey    String    @unique
  kind        String    @default("payment_received")
  recipient   String
  /// pending | sent | failed
  status      String    @default("pending")
  attempts    Int       @default(0)
  lastError   String?
  payload     String
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, updatedAt])
}

/// Tenant-wide Zeli request allowance for one calendar month. The conditional
/// increment makes concurrent requests unable to exceed the plan allowance.
model ZeliUsagePeriod {
  id          String   @id @default(cuid())
  tenantId    String
  /// YYYY-MM (UTC). Quotas reset on the first day of each calendar month.
  period      String
  requests    Int      @default(0)
  limit       Int
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([tenantId, period])
  @@index([period])
}

/// Customer consent and contact details for transactional receipts.
/// WhatsApp is deliberately separate from the ordinary mobile number: a
/// customer's phone is not assumed to be a WhatsApp account.
model CustomerMessagingPreference {
  id                 String    @id @default(cuid())
  customerId         String    @unique
  tenantId           String?
  whatsappNumber     String?
  /// unverified | verified
  whatsappStatus     String    @default("unverified")
  whatsappOptInAt    DateTime?
  whatsappOptInSource String?
  whatsappOptOutAt   DateTime?
  smsNumber          String?
  /// unverified | verified
  smsStatus          String    @default("unverified")
  smsOptInAt         DateTime?
  smsOptInSource     String?
  smsOptOutAt        DateTime?
  /// sms | whatsapp | null (no receipt channel)
  preferredChannel   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant   BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([preferredChannel])
}

/// Durable outbound customer-message queue. One row per receipt event and
/// channel; the unique event key makes a repeated confirmation harmless.
/// The recipient is stored encrypted and only a masked form is exposed.
model CustomerMessageOutbox {
  id                String    @id @default(cuid())
  eventKey          String    @unique
  tenantId          String?
  customerId        String
  /// sms | whatsapp
  channel           String
  /// receipt
  purpose           String    @default("receipt")
  reference         String
  recipientEncrypted String
  recipientMasked   String
  /// Rendered template parameters and safe display fields. No PIN or OTP.
  payload           String
  /// pending | sending | accepted | sent | delivered | read | failed | rejected
  status            String    @default("pending")
  attempts          Int       @default(0)
  nextAttemptAt     DateTime  @default(now())
  providerId        String?
  providerMessageId String?
  lastError         String?
  acceptedAt        DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant   BusinessTenant? @relation(fields: [tenantId], references: [id])
  statusEvents CustomerMessageStatusEvent[]

  @@index([tenantId, status])
  @@index([status, nextAttemptAt])
  @@index([customerId, createdAt])
  @@index([providerMessageId])
}

/// Idempotent delivery-status events from a provider webhook.
model CustomerMessageStatusEvent {
  id          String    @id @default(cuid())
  outboxId    String
  eventId     String    @unique
  status      String
  occurredAt  DateTime
  reason      String?
  createdAt   DateTime  @default(now())

  outbox CustomerMessageOutbox @relation(fields: [outboxId], references: [id], onDelete: Cascade)

  @@index([outboxId, occurredAt])
}

// ============================================================================
// PRIORITY A1 — RECONCILIATION, CASH AND FLOAT
// ============================================================================

/// One imported provider statement file.
///
/// An import is EVIDENCE ONLY. Nothing in this model or its rows is ever posted
/// to the MoMo ledger, a daily account or any other financial record. A matched
/// row links to an existing internal record for comparison; it never creates or
/// edits one.
model ProviderStatementImport {
  id            String    @id @default(cuid())
  tenantId      String?
  /// mtn | telecel | at_money
  provider      String
  fileName      String
  /// SHA-256 of the uploaded bytes. A tenant can import a file once.
  fileHash      String
  fileSizeBytes Int?
  /// JSON: provider header -> accepted column. Kept so a re-read is reproducible.
  columnMapping String?
  /// parsed | validated | rejected | reconciled
  status        String    @default("parsed")
  periodStart   DateTime?
  periodEnd     DateTime?
  rowCount      Int       @default(0)
  validRows     Int       @default(0)
  invalidRows   Int       @default(0)
  duplicateRows Int       @default(0)
  matchedRows   Int       @default(0)
  unmatchedRows Int       @default(0)
  currency      String    @default("GHS")
  note          String?
  importedById  String
  importedAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant BusinessTenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rows   ProviderStatementRow[]

  @@unique([tenantId, fileHash])
  @@index([tenantId, provider, createdAt])
  @@index([tenantId, status])
}

/// One line of an imported provider statement, exactly as received.
///
/// `fingerprint` is a deterministic hash of provider, reference, timestamp,
/// direction and amount. It is how a repeated line is detected across imports
/// without discarding the evidence: the row is stored with status `duplicate`
/// and points at the row it duplicates.
model ProviderStatementRow {
  id                String    @id @default(cuid())
  tenantId          String?
  importId          String
  rowNumber         Int
  fingerprint       String
  externalReference String?
  transactionAt     DateTime?
  /// in | out
  direction         String?
  amount            Decimal?
  fee               Decimal?
  balanceAfter      Decimal?
  description       String?
  /// The original line, truncated for evidence. Never rendered as HTML.
  rawRow            String?
  /// valid | invalid | duplicate | matched | unmatched | ignored
  status            String    @default("valid")
  validationError   String?
  duplicateOfId     String?
  /// momoTransaction | none
  matchedEntityType String?
  matchedEntityId   String?
  /// exact_reference | amount_and_time | manual
  matchType         String?
  matchedAt         DateTime?
  matchedById       String?
  createdAt         DateTime  @default(now())

  tenant BusinessTenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  import ProviderStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, rowNumber])
  @@index([tenantId, fingerprint])
  @@index([importId, status])
  @@index([tenantId, matchedEntityId])
}

/// A formal opening/closing liquidity snapshot for one branch and business day.
///
/// The three figures per asset are kept separate and are never collapsed:
///   declared  — what the operator declared at the start of the day,
///   adjusted  — declared plus transfers that moved value during the day,
///   counted   — what was physically counted / observed at close.
/// `variance` is counted minus adjusted and is the number an investigator works
/// from. A snapshot is an INTERNAL record. No figure here is provider-confirmed.
model BranchLiquiditySnapshot {
  id             String    @id @default(cuid())
  tenantId       String?
  locationId     String
  businessDate   DateTime
  dailyAccountId String?
  /// draft | submitted | reviewed
  status         String    @default("draft")
  note           String?
  recordedById   String
  submittedById  String?
  submittedAt    DateTime?
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant       BusinessTenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location     Location                @relation(fields: [locationId], references: [id])
  dailyAccount DailyAccount?           @relation(fields: [dailyAccountId], references: [id])
  lines        BranchLiquidityLine[]

  @@unique([tenantId, locationId, businessDate])
  @@index([tenantId, businessDate])
  @@index([tenantId, status])
}

/// One asset line of a branch liquidity snapshot.
model BranchLiquidityLine {
  id                 String   @id @default(cuid())
  tenantId           String?
  snapshotId         String
  /// cash | mtn_float | telecel_float | at_money_float
  assetType          String
  openingDeclared    Decimal  @default(0)
  /// Net movement from branch transfers during the day (may be negative).
  transferAdjustment Decimal  @default(0)
  expectedClose      Decimal  @default(0)
  countedClose       Decimal  @default(0)
  variance           Decimal  @default(0)
  note               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant   BusinessTenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  snapshot BranchLiquiditySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, assetType])
  @@index([tenantId, assetType])
}

/// Unified reconciliation exception case.
///
/// One queue for every unresolved discrepancy: provider statement lines, branch
/// liquidity variances, transfer variances, remittance differences and shift
/// variances all link here. A case carries an owner, an age, evidence and a
/// resolution. Resolving a case NEVER changes a financial record; the linked
/// correction is recorded by its own authorised workflow and referenced here.
model ReconciliationExceptionCase {
  id             String    @id @default(cuid())
  tenantId       String?
  caseNumber     String
  /// provider_statement | branch_liquidity | branch_transfer | remittance | shift | daily_close | other
  category       String
  /// high | medium | low
  severity       String    @default("medium")
  /// open | investigating | awaiting_evidence | resolved | dismissed
  status         String    @default("open")
  title          String
  description    String?
  ownerId        String?
  assignedAt     DateTime?
  dueAt          DateTime?
  evidence       String?
  resolutionType String?
  resolutionNote String?
  resolvedById   String?
  resolvedAt     DateTime?
  openedById     String
  openedAt       DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant BusinessTenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  links  ReconciliationExceptionLink[]
  events ReconciliationExceptionEvent[]

  @@unique([tenantId, caseNumber])
  @@index([tenantId, status, severity])
  @@index([tenantId, category])
  @@index([tenantId, ownerId])
}

/// A source record linked to an exception case. Polymorphic by design: a case
/// can link to a provider statement row, a transfer, a daily account, a shift or
/// a remittance without a nullable column per type.
model ReconciliationExceptionLink {
  id          String   @id @default(cuid())
  tenantId    String?
  caseId      String
  entityType  String
  entityId    String
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  tenant BusinessTenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   ReconciliationExceptionCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
  @@index([caseId, createdAt])
}

/// Append-only case timeline. Every state change writes one row.
model ReconciliationExceptionEvent {
  id        String   @id @default(cuid())
  tenantId  String?
  caseId    String
  /// opened | assigned | status_changed | note | evidence | resolved | reopened | link_added
  type      String
  actorId   String
  actorRole String?
  note      String?
  payload   String?
  createdAt DateTime @default(now())

  tenant BusinessTenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   ReconciliationExceptionCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@index([tenantId, type])
}
