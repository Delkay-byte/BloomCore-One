// BIK Prestige Enterprise Management Platform - Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =====================
// SHARED / CORE
// =====================

model User {
  id                 String    @id @default(cuid())
  tenantId           String?
  email              String    @unique
  fullName           String
  phone              String?
  role               String    @default("worker") // admin | worker | collector (primary role)
  status             String    @default("active")
  passwordHash       String
  forcePasswordReset Boolean   @default(false)
  momoEnabled        Boolean   @default(false) // Module capability: MoMo worker
  susuEnabled        Boolean   @default(false) // Module capability: Susu collector
  tokenVersion       Int       @default(0) // Bumped to invalidate existing sessions
  mfaEnabled         Boolean   @default(false)
  mfaSecret          String? // AES-256-GCM encrypted TOTP secret
  mfaRecoveryCodes   String? // JSON array of SHA-256 recovery-code hashes
  mfaEnrolledAt      DateTime?
  mfaLastUsedAt      DateTime?
  mfaLastTotpStep    Int? // Last accepted TOTP step (replay prevention)
  locationId         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  location              Location?            @relation(fields: [locationId], references: [id])
  dailyAccounts         DailyAccount[]
  collector             Collector?
  passwordResetTokens   PasswordResetToken[]
  devices               DeviceEnrollment[]
  recordedContributions Contribution[]       @relation("RecordedContributions")
  receivedContributions Contribution[]       @relation("ReceivedContributions")

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([role])
  @@index([status])
  @@index([locationId])
  @@index([tenantId])
}

model Location {
  id           String   @id @default(cuid())
  tenantId     String?
  name         String
  code         String
  description  String?
  address      String?
  contactPhone String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users         User[]
  dailyAccounts DailyAccount[]

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@index([status])
  @@index([code])
  @@index([tenantId])
}

model DailyAccount {
  id           String   @id @default(cuid())
  tenantId     String?
  locationId   String
  workerId     String
  businessDate DateTime

  openingMomoFloat       Decimal @default(0)
  openingCash            Decimal @default(0)
  totalCashIn            Decimal @default(0)
  totalCashOut           Decimal @default(0)
  totalCashReceived      Decimal @default(0)
  totalCashPaid          Decimal @default(0)
  commission             Decimal @default(0)
  otherIncome            Decimal @default(0)
  closingMomoFloat       Decimal @default(0)
  closingCash            Decimal @default(0)
  totalExpenses          Decimal @default(0)
  calculatedMomoVariance Decimal @default(0)
  calculatedCashVariance Decimal @default(0)
  reconciliationNote     String?

  status           String    @default("draft")
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedBy       String?
  correctedAt      DateTime?
  correctedById    String?
  correctionReason String?
  revisionCount    Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  location  Location               @relation(fields: [locationId], references: [id])
  worker    User                   @relation(fields: [workerId], references: [id])
  expenses  Expense[]
  revisions DailyAccountRevision[]

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@unique([locationId, businessDate])
  @@index([businessDate])
  @@index([locationId])
  @@index([workerId])
  @@index([status])
  @@index([submittedAt])
  @@index([tenantId])
}

model Expense {
  id             String   @id @default(cuid())
  tenantId       String?
  dailyAccountId String
  description    String
  amount         Decimal
  createdAt      DateTime @default(now())

  dailyAccount DailyAccount @relation(fields: [dailyAccountId], references: [id], onDelete: Cascade)

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([dailyAccountId])
  @@index([tenantId])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([tenantId])
}

// =====================
// SUSU MODULE
// =====================

model Customer {
  id           String   @id @default(cuid())
  tenantId     String?
  customerId   String   @unique // BIK-C-XXXXXX format, human-readable
  fullName     String
  phone        String?
  email        String?  @unique
  address      String?
  status       String   @default("active") // active | inactive
  registeredAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Customer Portal
  portalEnabled            Boolean   @default(false)
  portalPasswordHash       String?
  forcePortalPasswordReset Boolean   @default(false)
  tokenVersion             Int       @default(0) // Bumped to invalidate existing customer sessions
  mfaEnabled               Boolean   @default(false)
  mfaSecret                String? // AES-256-GCM encrypted TOTP secret
  mfaRecoveryCodes         String? // JSON array of SHA-256 recovery-code hashes
  mfaEnrolledAt            DateTime?
  mfaLastUsedAt            DateTime?
  mfaLastTotpStep          Int? // Last accepted TOTP step (replay prevention)

  accounts    SusuAccount[]
  assignments CollectorCustomerAssignment[]

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([status])
  @@index([customerId])
  @@index([phone])
  @@index([email])
  @@index([tenantId])
}

model SusuAccount {
  id                String   @id @default(cuid())
  tenantId          String?
  accountId         String   @unique // BIK-S-XXXXXX card number
  customerId        String
  dailyContribution Decimal // Customer's chosen daily contribution amount
  status            String   @default("active") // active | inactive | closed
  cardCustody       String   @default("customer") // customer | company | collector
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer      Customer                      @relation(fields: [customerId], references: [id])
  cycles        SusuCycle[]
  contributions Contribution[]
  withdrawals   Withdrawal[]
  commissions   Commission[]
  cardFees      CardFee[]
  assignments   CollectorCustomerAssignment[]

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([customerId])
  @@index([accountId])
  @@index([status])
  @@index([tenantId])
}

model SusuCycle {
  id                String   @id @default(cuid())
  tenantId          String?
  accountId         String
  cycleNumber       Int // 1, 2, 3, ... per account
  startDate         DateTime
  endDate           DateTime
  dailyContribution Decimal // Snapshot of contribution at cycle start
  status            String   @default("active") // active | completed
  commissionCharged Boolean  @default(false) // Has first withdrawal commission been charged this cycle?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  account       SusuAccount    @relation(fields: [accountId], references: [id])
  contributions Contribution[]
  withdrawals   Withdrawal[]
  commissions   Commission[]

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@unique([accountId, cycleNumber])
  @@index([accountId])
  @@index([status])
  @@index([startDate])
  @@index([tenantId])
}

model Contribution {
  id             String    @id @default(cuid())
  tenantId       String?
  accountId      String
  cycleId        String
  amount         Decimal // Total amount collected in this event
  collectionDate DateTime
  channel        String // collector | direct_office
  collectorId    String? // Reference to Collector if collected via collector
  recordedById   String // User who recorded the payment
  receivedById   String? // Staff (User) who recorded/authorised the office payment (audit)
  receivedByName String? // Free-text name of the staff who physically received the money
  recordedByName String? // Free-text name of the person who recorded the payment (display)
  referenceId    String    @unique // Idempotency key - prevents duplicate submissions
  notes          String?
  createdAt      DateTime  @default(now())
  reversedAt     DateTime?
  reversalOfId   String?   @unique // Original record when this row is a reversal

  account     SusuAccount              @relation(fields: [accountId], references: [id])
  cycle       SusuCycle                @relation(fields: [cycleId], references: [id])
  collector   Collector?               @relation(fields: [collectorId], references: [id])
  recordedBy  User                     @relation("RecordedContributions", fields: [recordedById], references: [id])
  receivedBy  User?                    @relation("ReceivedContributions", fields: [receivedById], references: [id])
  allocations ContributionAllocation[]

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([accountId])
  @@index([cycleId])
  @@index([collectionDate])
  @@index([channel])
  @@index([collectorId])
  @@index([receivedById])
  @@index([referenceId])
  @@index([tenantId])
}

model ContributionAllocation {
  id             String   @id @default(cuid())
  tenantId       String?
  contributionId String
  cycleDay       Int // Which day in the cycle (1-31) this allocation covers
  amount         Decimal // Amount allocated to this day
  createdAt      DateTime @default(now())

  contribution Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([contributionId])
  @@index([cycleDay])
  @@index([tenantId])
}

model Withdrawal {
  id               String    @id @default(cuid())
  tenantId         String?
  accountId        String
  cycleId          String
  requestedAmount  Decimal // What the customer asked to withdraw
  commissionAmount Decimal   @default(0) // Commission deducted (one-day contribution if first withdrawal)
  netAmount        Decimal // Amount actually paid to customer
  remainingBalance Decimal // Balance left after withdrawal
  status           String    @default("completed") // completed | pending | rejected
  authorizedById   String // Admin who authorized
  referenceId      String    @unique // Idempotency key
  notes            String?
  createdAt        DateTime  @default(now())
  reversedAt       DateTime?
  reversalOfId     String?   @unique // Original record when this row is a reversal

  account SusuAccount @relation(fields: [accountId], references: [id])
  cycle   SusuCycle   @relation(fields: [cycleId], references: [id])

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([accountId])
  @@index([cycleId])
  @@index([createdAt])
  @@index([referenceId])
  @@index([tenantId])
}

model Commission {
  id           String   @id @default(cuid())
  tenantId     String?
  accountId    String
  cycleId      String
  amount       Decimal // Equals one day's contribution
  basis        String // "one_day_contribution"
  triggeredBy  String // "first_withdrawal"
  recordedById String
  createdAt    DateTime @default(now())

  account SusuAccount @relation(fields: [accountId], references: [id])
  cycle   SusuCycle   @relation(fields: [cycleId], references: [id])

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([accountId])
  @@index([cycleId])
  @@index([tenantId])
}

model CardFee {
  id           String   @id @default(cuid())
  tenantId     String?
  accountId    String
  amount       Decimal  @default(10) // GH₵10 card fee
  recordedById String
  notes        String?
  createdAt    DateTime @default(now())

  account SusuAccount @relation(fields: [accountId], references: [id])

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([accountId])
  @@index([tenantId])
}

model Collector {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String   @unique
  status    String   @default("active") // active | inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User                          @relation(fields: [userId], references: [id])
  assignments   CollectorCustomerAssignment[]
  contributions Contribution[]
  remittances   CollectorRemittance[]

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([status])
  @@index([tenantId])
}

model CollectorCustomerAssignment {
  id           String    @id @default(cuid())
  tenantId     String?
  collectorId  String
  customerId   String
  accountId    String
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?
  active       Boolean   @default(true)

  collector Collector   @relation(fields: [collectorId], references: [id])
  customer  Customer    @relation(fields: [customerId], references: [id])
  account   SusuAccount @relation(fields: [accountId], references: [id])

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@unique([collectorId, accountId])
  @@index([collectorId])
  @@index([customerId])
  @@index([accountId])
  @@index([tenantId])
}

model CollectorRemittance {
  id             String    @id @default(cuid())
  tenantId       String?
  collectorId    String
  expectedAmount Decimal // Sum of recorded collections
  remittedAmount Decimal // Amount physically brought to office
  variance       Decimal // expected - remitted
  status         String    @default("pending") // pending | reconciled | discrepancy
  recordedById   String // Admin who recorded
  referenceId    String    @unique // Idempotency key
  notes          String?
  reversedAt     DateTime?
  reversedById   String?
  reversalReason String?
  createdAt      DateTime  @default(now())

  collector Collector @relation(fields: [collectorId], references: [id])

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([collectorId])
  @@index([status])
  @@index([createdAt])
  @@index([referenceId])
  @@index([tenantId])
}

/// Immutable snapshot of a daily account before an administrative correction.
/// The live DailyAccount row carries the corrected figures; this table preserves
/// the exact prior values, reason, author and version so history is auditable.
model DailyAccountRevision {
  id             String   @id @default(cuid())
  tenantId       String?
  dailyAccountId String
  version        Int
  snapshot       String // JSON of the financial fields and expenses before correction
  reason         String
  correctedById  String
  createdAt      DateTime @default(now())

  dailyAccount DailyAccount @relation(fields: [dailyAccountId], references: [id], onDelete: Cascade)

  @@unique([dailyAccountId, version])
  @@index([dailyAccountId])
  @@index([tenantId])
  @@index([createdAt])
}

// =====================
// PASSWORD RECOVERY
// =====================

model PasswordResetToken {
  id        String    @id @default(cuid())
  tenantId  String?
  userId    String
  tokenHash String    @unique // SHA-256 hash of the raw token — never store raw token
  expiresAt DateTime // Token expires after 15 minutes
  usedAt    DateTime? // Null until successfully used
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([tenantId])
}

// =====================
// OFFLINE / DEVICE ENROLLMENT
// =====================

model DeviceEnrollment {
  id           String    @id @default(cuid())
  tenantId     String?
  userId       String
  deviceId     String    @unique // Client-generated unique device identifier
  deviceName   String? // Human-readable device label
  module       String // "momo" | "susu"
  status       String    @default("active") // active | revoked
  lastSyncAt   DateTime?
  authorizedAt DateTime  @default(now()) // When last authorized (for offline timeout)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([deviceId])
  @@index([status])
  @@index([tenantId])
}

model OfflineTransaction {
  id             String    @id @default(cuid())
  tenantId       String?
  deviceId       String
  userId         String
  type           String // "contribution" | "daily_account_draft"
  idempotencyKey String    @unique // deviceId + UUID — server dedup key
  payload        String // JSON-encrypted transaction data
  status         String    @default("pending_sync") // pending_sync | syncing | synced | failed
  retryCount     Int       @default(0)
  maxRetries     Int       @default(5)
  failureReason  String?
  serverResult   String? // JSON server response after sync
  localTimestamp DateTime  @default(now()) // When created on device
  syncStartedAt  DateTime?
  syncedAt       DateTime? // When server confirmed
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([deviceId])
  @@index([userId])
  @@index([idempotencyKey])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([tenantId])
}

// =====================
// PLATFORM / MULTI-TENANCY
// =====================

/// A single enrolled business on the platform. Every tenant-owned record
/// carries a tenantId pointing here; all tenant data access resolves this
/// record from the authenticated server session (never from browser input).
model BusinessTenant {
  id                 String    @id @default(cuid())
  code               String    @unique // server-generated, e.g. BIK-A1B2C3
  name               String
  legalName          String?
  contactPhone       String?
  contactEmail       String?
  address            String?
  momoEnabled        Boolean   @default(false)
  susuEnabled        Boolean   @default(false)
  status             String    @default("PROVISIONING") // PROVISIONING | ACTIVE | SUSPENDED | ARCHIVED
  onboardingStatus   String    @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | COMPLETED
  primaryAdminUserId String?
  activatedAt        DateTime?
  suspendedAt        DateTime?
  suspensionReason   String?
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  users                        User[]
  locations                    Location[]
  dailyAccounts                DailyAccount[]
  expenses                     Expense[]
  auditLogs                    AuditLog[]
  customers                    Customer[]
  susuAccounts                 SusuAccount[]
  susuCycles                   SusuCycle[]
  contributions                Contribution[]
  contributionAllocations      ContributionAllocation[]
  withdrawals                  Withdrawal[]
  commissions                  Commission[]
  cardFees                     CardFee[]
  collectors                   Collector[]
  collectorCustomerAssignments CollectorCustomerAssignment[]
  collectorRemittances         CollectorRemittance[]
  passwordResetTokens          PasswordResetToken[]
  deviceEnrollments            DeviceEnrollment[]
  offlineTransactions          OfflineTransaction[]
  zeliEntitlements             ZeliEntitlement[]
  zeliAnalyticsDaily           ZeliAnalyticsDaily[]
  zeliAnalyticsRefreshes       ZeliAnalyticsRefresh[]
  zeliEntitlementEvents        ZeliEntitlementEvent[]

  @@index([status])
  @@index([onboardingStatus])
  @@index([momoEnabled])
  @@index([susuEnabled])
}

/// Platform operator identity (BloomCore). Completely separate from tenant
/// User accounts: own table, own cookie, own guard. Never a tenant admin.
model PlatformSuperAdmin {
  id                 String    @id @default(cuid())
  email              String    @unique
  fullName           String
  passwordHash       String
  status             String    @default("active") // active | inactive
  forcePasswordReset Boolean   @default(false)
  tokenVersion       Int       @default(0)
  mfaEnabled         Boolean   @default(false)
  mfaSecret          String? // AES-256-GCM encrypted TOTP secret
  mfaRecoveryCodes   String? // JSON array of SHA-256 recovery-code hashes
  mfaEnrolledAt      DateTime?
  mfaLastUsedAt      DateTime?
  mfaLastTotpStep    Int? // Last accepted TOTP step (replay prevention)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  auditLogs PlatformAuditLog[]
  oidcLinks PlatformOidcLink[]

  @@index([status])
}

/// OIDC identity link between a BloomCore Identity (Control Center / Authentik)
/// subject and a platform super administrator. Feature-flagged SSO; the link is
/// only created after the Control Center reports `verified`, or after the
/// administrator proves the CURRENT local password (pending path). One IdP
/// subject maps to at most one platform administrator and vice versa.
model PlatformOidcLink {
  id              String   @id @default(cuid())
  platformAdminId String
  issuer          String // exact OIDC issuer
  idpSub          String   @unique // `sub` claim from the IdP
  linkedVia       String // "cc_verified" | "local_credential_proof"
  createdBy       String? // platform admin id that completed a pending confirmation
  linkedAt        DateTime @default(now())

  platformAdmin PlatformSuperAdmin @relation(fields: [platformAdminId], references: [id])

  @@unique([issuer, platformAdminId])
  @@index([platformAdminId])
}

/// Server-side companion to a platform SessionRecord created through SSO.
/// Holds the (encrypted) IdP refresh token so logout can revoke it centrally.
/// Tokens never live in cookies; the row is deleted on logout.
model PlatformOidcSession {
  id              String   @id // SessionRecord jti
  platformAdminId String
  refreshTokenEnc String? // AES-256-GCM encrypted IdP refresh token
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@index([platformAdminId])
  @@index([expiresAt])
}

/// Platform-level audit trail. Deliberately isolated from tenant AuditLog so
/// the two security boundaries never mix. tenantId is a plain string (not a
/// relation) so platform history survives tenant archival.
model PlatformAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  tenantId   String?
  tenantCode String?
  entityType String?
  entityId   String?
  details    String?
  reason     String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor PlatformSuperAdmin? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([tenantId])
  @@index([createdAt])
}

// =====================
// SECURITY CONTROLS
// =====================
// Persistent, database-backed abuse controls. These tables hold keyed HMAC
// identifiers only — never raw email addresses, IP addresses or tokens.

/// Fixed-window request counter shared by every application instance.
model RateLimitCounter {
  id              String   @id @default(cuid())
  key             String   @unique // "<bucket>:<hmac>"
  count           Int      @default(0)
  windowStartedAt DateTime
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
}

/// Progressive failed-login state (1 min → 5 min → 15 min cooldowns).
model AuthThrottle {
  id              String    @id @default(cuid())
  key             String    @unique // "<scope>:<hmac>"
  failedCount     Int       @default(0)
  stage           Int       @default(0)
  windowStartedAt DateTime
  lastFailedAt    DateTime
  blockedUntil    DateTime?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([expiresAt])
  @@index([blockedUntil])
}

/// Single-use ledger for Cloudflare Turnstile tokens (replay protection).
model TurnstileTokenUse {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  usedAt    DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

/// Server-side session registry. A JWT is only accepted while its `jti` row
/// exists, is unexpired and has not been revoked.
model SessionRecord {
  id            String    @id // JWT `jti`
  subjectType   String // user | customer | platform
  subjectId     String
  tenantId      String?
  ipHash        String?
  userAgentHash String?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  // Provenance (Phase 1.1). Local logins leave these null; SSO sessions carry
  // the immutable Authentik subject and OIDC session id so central logout and
  // IdP back-channel logout revoke exactly these rows and never a local login.
  authSource    String?
  idpSub        String?
  idpSid        String?

  @@index([subjectType, subjectId])
  @@index([expiresAt])
  @@index([idpSub])
  @@index([idpSid])
}

/// Processed revocation message ids (replay/duplicate protection).
model OidcRevocationEvent {
  eventId    String   @id
  source     String   @default("control_center")
  receivedAt DateTime @default(now())
}

/// Administrator-issued, single-use account recovery code.
/// Only the hash is stored; the plaintext code is shown once to the issuing
/// administrator and is never returned by any read/API path.
model AccountRecoveryRequest {
  id              String    @id @default(cuid())
  tenantId        String?
  targetType      String // user | customer
  targetId        String
  requestedById   String
  requestedByType String // platform | user
  reason          String
  codeHash        String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([tenantId])
  @@index([targetType, targetId])
  @@index([expiresAt])
}

// =====================
// ZELI ASSISTANT
// =====================

/// A private assistant conversation. Ownership is tenant + authenticated user;
/// no cross-tenant or cross-user lookup is permitted.
model ZeliConversation {
  id        String        @id @default(cuid())
  tenantId  String?
  userId    String
  userType  String        @default("user") // user | customer | platform
  title     String        @default("New conversation")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  messages  ZeliMessage[]

  @@index([tenantId, userId, updatedAt])
  @@index([deletedAt])
}

model ZeliMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user | assistant
  content        String
  sources        String? // JSON array of {label, href?, detail?}
  toolCalls      String? // JSON metadata: tool name, outcome, duration
  provider       String?
  model          String?
  feedback       String? // helpful | unhelpful
  createdAt      DateTime @default(now())

  conversation ZeliConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([feedback])
}

/// Per-user daily request budget. Enforced server-side; no client trust.
model ZeliUsage {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String
  day       String // YYYY-MM-DD (UTC)
  requests  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId, day])
  @@index([day])
}

// =====================
// ZELI BUSINESS INTELLIGENCE
// =====================

/// A tenant's Zeli Business Intelligence entitlement. This is the single
/// subscription/entitlement record for the product feature: there is no second
/// billing architecture. Platform administrators manage it with an audited,
/// reason-bearing workflow; tenant administrators can read access but cannot
/// grant it to themselves.
model ZeliEntitlement {
  id            String    @id @default(cuid())
  tenantId      String
  featureKey    String    @default("zeli_analytics")
  status        String    @default("active") // active | suspended | revoked
  source        String    @default("manual") // manual | subscription
  reason        String?
  startsAt      DateTime  @default(now())
  expiresAt     DateTime?
  grantedById   String?
  grantedByType String? // platform
  suspendedAt   DateTime?
  revokedAt     DateTime?
  revokedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant BusinessTenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events ZeliEntitlementEvent[]

  @@unique([tenantId, featureKey])
  @@index([tenantId])
  @@index([status])
  @@index([expiresAt])
}

/// Append-only entitlement history. Every grant, suspension, revocation,
/// reactivation and expiry sweep is recorded with a mandatory reason.
model ZeliEntitlementEvent {
  id             String    @id @default(cuid())
  entitlementId  String?
  tenantId       String
  featureKey     String    @default("zeli_analytics")
  action         String // granted | activated | suspended | revoked | expired
  previousStatus String?
  status         String
  reason         String
  actorId        String?
  actorType      String // platform | system
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  entitlement ZeliEntitlement? @relation(fields: [entitlementId], references: [id], onDelete: SetNull)
  tenant      BusinessTenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([entitlementId, createdAt])
}

/// Tenant-scoped daily analytics aggregate. Rows are derived from authoritative
/// financial records and are rebuilt for a requested range, never edited by a
/// browser. The unique key makes repeated refresh idempotent: a duplicate event
/// updates the same row instead of double-counting.
model ZeliAnalyticsDaily {
  id                 String   @id @default(cuid())
  tenantId           String
  businessDate       String // YYYY-MM-DD (UTC bucket)
  scope              String   @default("all") // "all" or a location id
  contributions      Decimal  @default(0)
  contributionCount  Int      @default(0)
  withdrawals        Decimal  @default(0)
  withdrawalCount    Int      @default(0)
  commissions        Decimal  @default(0)
  remittances        Decimal  @default(0)
  remittanceVariance Decimal  @default(0)
  remittanceCount    Int      @default(0)
  expenses           Decimal  @default(0)
  expenseCount       Int      @default(0)
  cashIncome         Decimal  @default(0)
  transactionCount   Int      @default(0)
  activeCustomers    Int      @default(0)
  newCustomers       Int      @default(0)
  refreshedAt        DateTime @default(now())

  tenant BusinessTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scope, businessDate])
  @@index([tenantId, businessDate])
  @@index([tenantId, scope, businessDate])
}

/// Refresh bookkeeping for a tenant/scope/range. Used for freshness labels,
/// retry visibility and operational health. It stores no financial values.
model ZeliAnalyticsRefresh {
  id          String   @id @default(cuid())
  tenantId    String
  scope       String   @default("all")
  rangeStart  String
  rangeEnd    String
  status      String   @default("ok") // ok | failed
  rowCount    Int      @default(0)
  durationMs  Int      @default(0)
  error       String?
  refreshedAt DateTime @default(now())

  tenant BusinessTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scope, rangeStart, rangeEnd])
  @@index([tenantId, refreshedAt])
}

/// Privacy gateway decision log. It records that a payload was allowed or
/// denied and why, with only allow-list category names and counts. It never
/// stores payload values, customer records or prompts.
model ZeliProviderGatewayEvent {
  id                   String   @id @default(cuid())
  tenantId             String?
  provider             String
  decision             String // allowed | denied
  reason               String
  policyVersion        String
  payloadCategories    String? // JSON array of allow-listed metric names
  observationCount     Int?
  suppressedGroupCount Int?
  createdAt            DateTime @default(now())

  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@index([decision])
}
