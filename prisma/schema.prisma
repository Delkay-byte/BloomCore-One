// BIK Prestige Enterprise Management Platform - Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Prisma 7: the connection URL lives in prisma.config.ts for CLI commands and
  // in the driver adapter passed by src/lib/db.ts at runtime.
}

// =====================
// SHARED / CORE
// =====================

model User {
  id                    String    @id @default(cuid())
  tenantId              String?
  email                 String    @unique
  fullName              String
  phone                 String?
  role                  String    @default("worker") // admin | worker | collector (primary role)
  status                String    @default("active")
  passwordHash          String
  forcePasswordReset    Boolean   @default(false)
  emailVerified         Boolean   @default(true)
  emailVerifiedAt       DateTime?
  passwordPolicyVersion Int       @default(0)
  momoEnabled           Boolean   @default(false) // Module capability: MoMo worker
  susuEnabled           Boolean   @default(false) // Module capability: Susu collector
  tokenVersion          Int       @default(0) // Bumped to invalidate existing sessions
  mfaEnabled            Boolean   @default(false)
  mfaSecret             String? // AES-256-GCM encrypted TOTP secret
  mfaRecoveryCodes      String? // Legacy JSON array (migrated to MfaRecoveryCode rows)
  mfaPendingSecretAt    DateTime? // SEC-15: pending TOTP secret issued at this time
  mfaEnrolledAt         DateTime?
  mfaLastUsedAt         DateTime?
  mfaLastTotpStep       Int? // Last accepted TOTP step (replay prevention)
  locationId            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  location                 Location?                @relation(fields: [locationId], references: [id])
  dailyAccounts            DailyAccount[]
  collector                Collector?
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  devices                  DeviceEnrollment[]
  recordedContributions    Contribution[]           @relation("RecordedContributions")
  receivedContributions    Contribution[]           @relation("ReceivedContributions")
  recordedMomoTransactions MomoTransaction[]        @relation("MomoTransactionRecordedBy")

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([role])
  @@index([status])
  @@index([locationId])
  @@index([tenantId])
}

model Location {
  id           String   @id @default(cuid())
  tenantId     String?
  name         String
  code         String
  description  String?
  address      String?
  contactPhone String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users              User[]
  dailyAccounts      DailyAccount[]
  momoTransactions   MomoTransaction[]
  assetBalances      BranchAssetBalance[]
  outgoingTransfers  BranchTransfer[]          @relation("TransferSource")
  incomingTransfers  BranchTransfer[]          @relation("TransferDestination")
  shifts             Shift[]
  liquiditySnapshots BranchLiquiditySnapshot[]
  susuReconciliations SusuReconciliation[]
  dailyCollectorClosings DailyCollectorClosing[]

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@index([status])
  @@index([code])
  @@index([tenantId])
}

model DailyAccount {
  id           String   @id @default(cuid())
  tenantId     String?
  locationId   String
  workerId     String
  businessDate DateTime

  openingMomoFloat       Decimal   @default(0)
  openingCash            Decimal   @default(0)
  additionalCashReceived Decimal   @default(0)
  additionalMomoFloat    Decimal   @default(0)
  totalCashIn            Decimal   @default(0)
  totalCashOut           Decimal   @default(0)
  totalAirtimeSold       Decimal   @default(0)
  totalCashReceived      Decimal   @default(0)
  totalCashPaid          Decimal   @default(0)
  commission             Decimal   @default(0)
  debtsCollected         Decimal   @default(0)
  otherIncome            Decimal   @default(0)
  closingMomoFloat       Decimal   @default(0)
  closingCash            Decimal   @default(0)
  totalExpenses          Decimal   @default(0)
  calculatedMomoVariance Decimal   @default(0)
  calculatedCashVariance Decimal   @default(0)
  calculatedDifference   Decimal   @default(0)
  differenceStatus       String    @default("balanced")
  reconciliationNote     String?
  // Physical handover confirmation. Separate from accounting review: a reviewed
  // account does not prove the money was received.
  actualAmountReceived   Decimal?
  handoverDifference     Decimal?
  handoverNote           String?
  handoverConfirmedAt    DateTime?
  handoverConfirmedBy    String?

  status           String    @default("draft")
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedBy       String?
  correctedAt      DateTime?
  correctedById    String?
  correctionReason String?
  revisionCount    Int       @default(0)

  // Financial source of truth for the day.
  //   aggregate — opening/closing plus manual commission, debts and expenses.
  //   ledger    — commission, debts, other income and expenses derive from the
  //               operational MomoTransaction rows; principal customer
  //               transactions never enter the accountability formula.
  // The mode is set once, explicitly, before any ledger entry is recorded. A
  // historical aggregate row is never converted or back-filled silently.
  ledgerMode              String    @default("aggregate")
  ledgerCutoverAt         DateTime?
  // Where this day's opening figures came from: manual | carried | manual_adjusted
  openingBalanceSource    String    @default("manual")
  carriedFromAccountId    String?
  openingAdjustmentReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location           Location                  @relation(fields: [locationId], references: [id])
  worker             User                      @relation(fields: [workerId], references: [id])
  expenses           Expense[]
  revisions          DailyAccountRevision[]
  liquiditySnapshots BranchLiquiditySnapshot[]
  momoTransactions   MomoTransaction[]
  shifts             Shift[]

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@unique([locationId, businessDate])
  @@index([businessDate])
  @@index([locationId])
  @@index([workerId])
  @@index([status])
  @@index([submittedAt])
  @@index([tenantId])
}

/// Operational MoMo transaction ledger entry.
///
/// Every row is an operator-recorded operational record. Nothing here is a
/// provider confirmation or a statement import; `recordingSource` always says
/// so. Principal customer movements (cash in, cash out, airtime) are retained
/// for operational reporting but never enter the accountability formula, which
/// keeps them from being counted as business revenue or profit.
///
/// Corrections and reversals are append-only. The superseded row keeps all of
/// its original values and only changes status; the successor or reversal row
/// carries the linkage so the full history stays auditable.
model MomoTransaction {
  id                    String   @id @default(cuid())
  tenantId              String?
  locationId            String
  dailyAccountId        String?
  /// The employee the transaction belongs to (the operator who recorded it).
  workerId              String
  /// cash_in | cash_out | airtime_sale | commission | debts_collected |
  /// other_income | expense
  type                  String
  /// mtn | telecel | at_money | other | unassigned
  network               String   @default("unassigned")
  /// inflow | outflow | neutral | reversal
  direction             String
  amount                Decimal  @default(0)
  /// Provider/business commission earned on this transaction. A day-total
  /// commission row (type=commission) takes precedence over per-transaction
  /// commission so the same money is never counted twice.
  commissionAmount      Decimal  @default(0)
  businessDate          DateTime
  occurredAt            DateTime
  /// Operator business reference; unique per tenant.
  reference             String
  /// Provider reference when the operator has one. Optional and non-verified.
  externalReference     String?
  /// manual_operator | statement_import | provider_api (future sources)
  recordingSource       String   @default("manual_operator")
  /// operator_recorded | statement_imported | provider_confirmed | disputed
  /// Only an integration may set provider_confirmed. Manual entry cannot.
  verificationStatus    String   @default("operator_recorded")
  /// Enrolled device that captured the entry, when one is available.
  recordedDeviceId      String?
  recordedDeviceName    String?
  /// Free-text pointer to the receipt, statement line or other evidence.
  supportingEvidence    String?
  /// recorded | reversed | corrected | reversal
  status                String   @default("recorded")
  idempotencyKey        String
  reversesTransactionId String?  @unique
  correctsTransactionId String?
  correctionReason      String?
  note                  String?
  recordedById          String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant       BusinessTenant?  @relation(fields: [tenantId], references: [id])
  location     Location         @relation(fields: [locationId], references: [id])
  dailyAccount DailyAccount?    @relation(fields: [dailyAccountId], references: [id])
  worker       User             @relation("MomoTransactionRecordedBy", fields: [workerId], references: [id])
  reversalOf   MomoTransaction? @relation("MomoTransactionReversal", fields: [reversesTransactionId], references: [id])
  reversal     MomoTransaction? @relation("MomoTransactionReversal")

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, reference])
  @@unique([tenantId, network, externalReference])
  @@index([tenantId, businessDate])
  @@index([locationId, businessDate])
  @@index([workerId, businessDate])
  @@index([dailyAccountId, status])
  @@index([type, status])
  @@index([tenantId, verificationStatus])
  @@index([createdAt])
}

/// Declared internal balance for one asset at one location.
///
/// This is an operator declaration, never a provider-confirmed balance.
/// `declaredAt` is the baseline timestamp: transfer movements are applied only
/// when they happened after it, so a newly declared snapshot is not reduced
/// twice by transfers the operator already counted.
model BranchAssetBalance {
  id              String   @id @default(cuid())
  tenantId        String?
  locationId      String
  /// cash | mtn_float | telecel_float | at_money_float
  assetType       String
  declaredBalance Decimal  @default(0)
  declaredAt      DateTime @default(now())
  declaredById    String?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   BusinessTenant? @relation(fields: [tenantId], references: [id])
  location Location        @relation(fields: [locationId], references: [id])

  @@unique([tenantId, locationId, assetType])
  @@index([tenantId, assetType])
  @@index([locationId])
}

/// Internal branch-to-branch transfer of physical cash or declared network
/// float. The lifecycle is append-only: each transition writes an immutable
/// event row, and the transfer row carries the current state plus the actor of
/// every completed step.
model BranchTransfer {
  id                    String    @id @default(cuid())
  tenantId              String?
  reference             String
  /// cash | mtn_float | telecel_float | at_money_float
  assetType             String
  /// mtn | telecel | at_money | none (derived from the asset type)
  network               String    @default("none")
  sourceLocationId      String
  destinationLocationId String
  amount                Decimal
  /// draft | requested | approved | dispatched | received | completed |
  /// rejected | cancelled | disputed | variance_investigation
  status                String    @default("requested")
  purpose               String?
  notes                 String?
  initiatedById         String
  requestedAt           DateTime?
  approvedById          String?
  approvedAt            DateTime?
  dispatchedById        String?
  dispatchedAt          DateTime?
  /// Receipt number, waybill or other evidence held for the dispatch.
  dispatchEvidence      String?
  receivedById          String?
  receivedAt            DateTime?
  actualAmountReceived  Decimal?
  /// Receipt number, count sheet or other evidence held at the destination.
  receiptEvidence       String?
  variance              Decimal?
  varianceReason        String?
  /// Sanctioned partial settlement. `settledAmount` is the value finally
  /// accepted at the destination; `outstandingAmount` is the remainder that the
  /// follow-up transfer or a write-back resolution must cover. This is never a
  /// silent reduction of the dispatched amount: the original `amount` stays.
  settlementStatus      String?
  settledAmount         Decimal?
  outstandingAmount     Decimal?
  followUpTransferId    String?
  parentTransferId      String?
  settledById           String?
  settledAt             DateTime?

  /// The transfer that settles the remaining balance of this one (many
  /// follow-ups may settle one original, so this side is not unique).
  followUps          BranchTransfer[] @relation("TransferFollowUp")
  /// Set when this transfer was created to settle an earlier partial receipt.
  parentTransfer     BranchTransfer?  @relation("TransferFollowUp", fields: [parentTransferId], references: [id])
  rejectedById       String?
  rejectedAt         DateTime?
  rejectionReason    String?
  cancelledById      String?
  cancelledAt        DateTime?
  cancellationReason String?
  resolvedById       String?
  resolvedAt         DateTime?
  resolutionNote     String?
  idempotencyKey     String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  tenant      BusinessTenant?       @relation(fields: [tenantId], references: [id])
  source      Location              @relation("TransferSource", fields: [sourceLocationId], references: [id])
  destination Location              @relation("TransferDestination", fields: [destinationLocationId], references: [id])
  events      BranchTransferEvent[]

  @@unique([tenantId, reference])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@index([sourceLocationId, assetType])
  @@index([destinationLocationId, assetType])
  @@index([status])
}

/// Immutable lifecycle history for a branch transfer.
model BranchTransferEvent {
  id         String   @id @default(cuid())
  tenantId   String?
  transferId String
  action     String
  actorId    String
  actorName  String?
  note       String?
  createdAt  DateTime @default(now())

  transfer BranchTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId, createdAt])
  @@index([tenantId, createdAt])
}

/// A working shift at one location on one business day.
///
/// A daily account can have several shifts. Shifts are accountability
/// snapshots: their opening/closing figures are never added into the daily
/// account's reconciliation, so the two records cannot double count.
model Shift {
  id                      String    @id @default(cuid())
  tenantId                String?
  locationId              String
  dailyAccountId          String?
  reference               String
  businessDate            DateTime
  /// morning | afternoon | evening | custom
  name                    String
  label                   String?
  assignedUserId          String
  /// draft | open | awaiting_handover | variance_open | closed | cancelled
  status                  String    @default("draft")
  scheduledStart          DateTime?
  scheduledEnd            DateTime?
  openingCash             Decimal   @default(0)
  openingMomoFloat        Decimal   @default(0)
  /// manual | carried | manual_adjusted
  openingSource           String    @default("manual")
  carriedFromShiftId      String?
  openingAdjustmentReason String?
  closingCash             Decimal?
  closingMomoFloat        Decimal?
  closingNotes            String?
  openedById              String?
  openedAt                DateTime?
  closedById              String?
  closedAt                DateTime?
  createdById             String
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  tenant       BusinessTenant? @relation(fields: [tenantId], references: [id])
  location     Location        @relation(fields: [locationId], references: [id])
  dailyAccount DailyAccount?   @relation(fields: [dailyAccountId], references: [id])
  handovers    ShiftHandover[]
  revisions    ShiftRevision[]

  @@unique([tenantId, locationId, businessDate, name])
  @@unique([tenantId, reference])
  @@index([tenantId, businessDate])
  @@index([locationId, businessDate])
  @@index([assignedUserId, businessDate])
  @@index([status])
}

/// Two-sided shift handover. The outgoing employee's declared figures are
/// immutable once submitted; the receiving employee records their own counted
/// figures separately. A difference is preserved as a variance and stays open
/// until an administrator resolves it.
model ShiftHandover {
  id                    String    @id @default(cuid())
  tenantId              String?
  shiftId               String
  reference             String
  outgoingUserId        String
  outgoingCash          Decimal
  outgoingMomoFloat     Decimal
  outstandingOperations String?
  outgoingNotes         String?
  /// Count sheet, till slip or other evidence held for the outgoing count.
  outgoingEvidence      String?
  incomingUserId        String?
  incomingCash          Decimal?
  incomingMomoFloat     Decimal?
  operationsAccepted    Boolean?
  incomingNotes         String?
  /// Count sheet, receipt or other evidence held for the receiving count.
  incomingEvidence      String?
  cashVariance          Decimal?
  floatVariance         Decimal?
  varianceReason        String?
  /// awaiting_receipt | confirmed | variance_open | resolved
  status                String    @default("awaiting_receipt")
  confirmedAt           DateTime?
  resolvedById          String?
  resolvedAt            DateTime?
  resolutionNote        String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])
  shift  Shift           @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([tenantId, reference])
  @@index([shiftId, createdAt])
  @@index([tenantId, status])
  @@index([outgoingUserId])
  @@index([incomingUserId])
}

/// Deterministic operational finding produced by a named threshold rule.
///
/// No probabilistic or AI classification is used. Each finding carries the
/// rule, the measured value, the threshold and the supporting record so an
/// administrator can check it. The unique fingerprint prevents a repeated scan
/// from duplicating the same finding.
/// One append-only step in a finding's life: a scan that re-saw it, an
/// acknowledgment, an assignment, a comment, a closure or a reopening.
///
/// A rescan used to overwrite `evidence` and `lastSeenAt` in place, so the state
/// a person acted on was lost. Every scan that changes the metric, the severity
/// or the evidence now appends an event instead, and the snapshot hash names the
/// exact evidence that was seen.
model AnomalyFindingEvent {
  id             String   @id @default(cuid())
  tenantId       String?
  anomalyId      String
  /// detected | rescan | acknowledged | assigned | commented | escalated |
  /// resolved | false_positive | reopened | suppressed
  kind           String
  severity       String?
  metricValue    Decimal?
  thresholdValue Decimal?
  summary        String?
  /// Canonical JSON of the evidence captured at this step.
  evidence       String?
  /// SHA-256 of the canonical evidence and the entity reference.
  snapshotHash   String?
  note           String?
  actorId        String?
  scanRunId      String?
  createdAt      DateTime @default(now())

  tenant  BusinessTenant?    @relation(fields: [tenantId], references: [id])
  anomaly OperationalAnomaly @relation(fields: [anomalyId], references: [id], onDelete: Cascade)

  @@index([tenantId, anomalyId, createdAt])
  @@index([tenantId, kind, createdAt])
}

/// The investigation of one finding: who owns it, what it is waiting for, what
/// was checked, and which correction closed it.
model AnomalyInvestigation {
  id                   String    @id @default(cuid())
  tenantId             String?
  anomalyId            String    @unique
  /// open | investigating | awaiting_evidence | closed
  status               String    @default("open")
  assigneeId           String?
  dueAt                DateTime?
  /// genuine | false_positive | inconclusive
  disposition          String?
  dispositionNote      String?
  /// The correction or reversal that resolved the underlying condition.
  linkedCorrectionType String?
  linkedCorrectionId   String?
  openedById           String
  closedById           String?
  closedAt             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant   BusinessTenant?               @relation(fields: [tenantId], references: [id])
  anomaly  OperationalAnomaly            @relation(fields: [anomalyId], references: [id], onDelete: Cascade)
  tasks    AnomalyInvestigationTask[]
  comments AnomalyInvestigationComment[]

  @@index([tenantId, status, dueAt])
  @@index([tenantId, assigneeId])
}

/// A checklist step on an investigation, so "checked" is a recorded fact.
model AnomalyInvestigationTask {
  id              String    @id @default(cuid())
  tenantId        String?
  investigationId String
  label           String
  sequence        Int       @default(0)
  doneById        String?
  doneAt          DateTime?
  createdAt       DateTime  @default(now())

  tenant        BusinessTenant?      @relation(fields: [tenantId], references: [id])
  investigation AnomalyInvestigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  @@index([investigationId, sequence])
}

/// A comment on an investigation. Comments are never edited or deleted.
model AnomalyInvestigationComment {
  id              String   @id @default(cuid())
  tenantId        String?
  investigationId String
  authorId        String
  body            String
  createdAt       DateTime @default(now())

  tenant        BusinessTenant?      @relation(fields: [tenantId], references: [id])
  investigation AnomalyInvestigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  @@index([investigationId, createdAt])
}

/// A time-boxed decision not to raise a rule again for one scope.
///
/// Suppression is how a known false positive is handled without pretending the
/// rule is wrong for everyone: it needs a reason, an expiry and can be revoked,
/// and a suppression never deletes the findings it covers.
model AnomalySuppression {
  id           String    @id @default(cuid())
  tenantId     String?
  ruleKey      String
  /// When set, only this entity is covered; otherwise the whole rule is.
  entityType   String?
  entityId     String?
  reason       String
  createdById  String
  expiresAt    DateTime
  revokedById  String?
  revokedAt    DateTime?
  revokeReason String?
  createdAt    DateTime  @default(now())

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, ruleKey, expiresAt])
}

/// One scan attempt, manual or scheduled.
///
/// The run row is the alert-fatigue control: it records how many findings were
/// seen, created, reopened, suppressed and notified, so a noisy rule can be seen
/// and a scheduled scan that failed is not silent.
model AnomalyScanRun {
  id         String    @id @default(cuid())
  tenantId   String?
  /// manual | scheduled
  trigger    String    @default("manual")
  /// running | completed | failed
  status     String    @default("running")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  scanned    Int       @default(0)
  created    Int       @default(0)
  reopened   Int       @default(0)
  suppressed Int       @default(0)
  notified   Int       @default(0)
  periodFrom String?
  periodTo   String?
  error      String?

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, startedAt])
}

/// One AI-assisted explanation of a finding, generated against a specific evidence
/// pack and kept for review.
///
/// A draft never changes a finding, a transaction or a balance: it is an explanation
/// that a named person either accepts or rejects, and the pack hash proves which
/// evidence the explanation was written from.
model AnomalyInvestigationDraft {
  id             String    @id @default(cuid())
  tenantId       String?
  anomalyId      String
  /// SHA-256 of the evidence pack the draft was generated from.
  evidenceHash   String
  evidence       String
  promptVersion  String
  schemaVersion  String
  /// deterministic | external
  source         String    @default("deterministic")
  model          String
  /// draft | reviewed | accepted | rejected
  status         String    @default("draft")
  /// The validated payload, stored exactly as reviewed.
  payload        String
  generatedById  String
  reviewedById   String?
  reviewedAt     DateTime?
  reviewReason   String?
  /// Rejections are kept, so a second draft can be compared with the first.
  supersededById String?
  createdAt      DateTime  @default(now())

  tenant  BusinessTenant?    @relation(fields: [tenantId], references: [id])
  anomaly OperationalAnomaly @relation(fields: [anomalyId], references: [id], onDelete: Cascade)

  @@index([tenantId, anomalyId, createdAt])
  @@index([tenantId, status])
}

model OperationalAnomaly {
  id               String    @id @default(cuid())
  tenantId         String?
  fingerprint      String
  /// daily_shortage | daily_overage | repeated_shortage | unreviewed_account |
  /// missing_account | large_transaction | repeated_reversal | expense_spike |
  /// transfer_variance | stale_transfer | shift_variance |
  /// repeated_shift_variance | unconfirmed_handover
  ruleKey          String
  /// high | medium | low
  severity         String
  /// open | acknowledged | resolved
  status           String    @default("open")
  title            String
  summary          String
  entityType       String
  entityId         String
  locationId       String?
  workerId         String?
  businessDate     DateTime?
  metricValue      Decimal?
  thresholdValue   Decimal?
  evidence         String?
  detectedAt       DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  firstSeenAt      DateTime  @default(now())
  /// SHA-256 of the evidence this finding was last seen with.
  snapshotHash     String?
  /// How many times a resolved finding came back.
  reopenCount      Int       @default(0)
  lastNotifiedAt   DateTime?
  acknowledgedById String?
  acknowledgedAt   DateTime?
  resolvedById     String?
  resolvedAt       DateTime?
  resolutionNote   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant        BusinessTenant?             @relation(fields: [tenantId], references: [id])
  events        AnomalyFindingEvent[]
  investigation AnomalyInvestigation?
  drafts        AnomalyInvestigationDraft[]

  @@unique([tenantId, fingerprint])
  @@index([tenantId, status, severity])
  @@index([tenantId, ruleKey])
  @@index([tenantId, businessDate])
  @@index([locationId])
  @@index([workerId])
}

model Expense {
  id             String   @id @default(cuid())
  tenantId       String?
  dailyAccountId String
  description    String
  amount         Decimal
  createdAt      DateTime @default(now())

  dailyAccount DailyAccount @relation(fields: [dailyAccountId], references: [id], onDelete: Cascade)

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([dailyAccountId])
  @@index([tenantId])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  /// Branch responsible at creation. Never rewritten by later transfers.
  branchId   String?
  userId     String
  /// Snapshot of the actor at the time of the action. A later rename or
  /// removal must not rewrite who performed the historical action.
  actorName  String?
  actorRole  String?
  /// user | customer | system
  actorType  String?
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([tenantId])
  @@index([branchId])
}

// =====================
// SUSU MODULE
// =====================

model Customer {
  id           String   @id @default(cuid())
  tenantId     String?
  customerId   String   @unique // BIK-C-XXXXXX format, human-readable
  fullName     String
  phone        String?
  email        String?  @unique
  address      String?
  status       String   @default("active") // active | inactive
  registeredAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Customer Portal
  portalEnabled            Boolean   @default(false)
  portalPasswordHash       String?
  forcePortalPasswordReset Boolean   @default(false)
  passwordPolicyVersion    Int       @default(0)
  tokenVersion             Int       @default(0) // Bumped to invalidate existing customer sessions
  mfaEnabled               Boolean   @default(false)
  mfaSecret                String? // AES-256-GCM encrypted TOTP secret
  mfaRecoveryCodes         String? // Legacy JSON array (migrated to MfaRecoveryCode rows)
  mfaPendingSecretAt       DateTime? // SEC-15: pending TOTP secret issued at this time
  mfaEnrolledAt            DateTime?
  mfaLastUsedAt            DateTime?
  mfaLastTotpStep          Int? // Last accepted TOTP step (replay prevention)

  accounts                   SusuAccount[]
  assignments                CollectorCustomerAssignment[]
  disputes                   CustomerDispute[]
  messagingPreference        CustomerMessagingPreference?
  withdrawalRequests         CustomerWithdrawalRequest[]
  customerMessages           CustomerMessageOutbox[]
  messagingConsentChallenges MessagingConsentChallenge[]

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([status])
  @@index([customerId])
  @@index([phone])
  @@index([email])
  @@index([tenantId])
}

model SusuAccount {
  id                String   @id @default(cuid())
  tenantId          String?
  accountId         String   @unique // BIK-S-XXXXXX card number
  customerId        String
  dailyContribution Decimal // Customer's chosen daily contribution amount
  status            String   @default("active") // active | inactive | closed
  cardCustody       String   @default("customer") // customer | company | collector
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customer           Customer                      @relation(fields: [customerId], references: [id])
  cycles             SusuCycle[]
  contributions      Contribution[]
  withdrawals        Withdrawal[]
  commissions        Commission[]
  cardFees           CardFee[]
  assignments        CollectorCustomerAssignment[]
  disputes           CustomerDispute[]
  withdrawalRequests CustomerWithdrawalRequest[]

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([customerId])
  @@index([accountId])
  @@index([status])
  @@index([tenantId])
}

model SusuCycle {
  id                String   @id @default(cuid())
  tenantId          String?
  accountId         String
  cycleNumber       Int // 1, 2, 3, ... per account
  startDate         DateTime
  endDate           DateTime
  dailyContribution Decimal // Snapshot of contribution at cycle start
  status            String   @default("active") // active | completed
  commissionCharged Boolean  @default(false) // Has first withdrawal commission been charged this cycle?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  account       SusuAccount    @relation(fields: [accountId], references: [id])
  contributions Contribution[]
  withdrawals   Withdrawal[]
  commissions   Commission[]

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@unique([accountId, cycleNumber])
  @@index([accountId])
  @@index([status])
  @@index([startDate])
  @@index([tenantId])
}

/// A customer's dispute about one recorded contribution or withdrawal.
///
/// The dispute is a review record, not a money movement. Resolving it never
/// edits or reverses the financial row silently; an upheld outcome must be
/// carried out through the existing correction/reversal control and referenced
/// in `outcomeReference`.
/// A stored evidence file.
///
/// The bytes live outside the database in a private directory; the row records
/// what they are, who attached them, the SHA-256 of the exact content and how
/// long they must be kept. Access is always re-checked against the subject, so a
/// file reference cannot be traded for a download.
model EvidenceAttachment {
  id             String    @id @default(cuid())
  tenantId       String?
  /// customerDispute | operationalAnomaly | offlineActionRequest
  subjectType    String
  subjectId      String
  fileName       String
  contentType    String
  sizeBytes      Int
  sha256         String
  /// Opaque storage key inside the private evidence directory.
  storageKey     String    @unique
  uploadedById   String
  uploadedByType String    @default("admin")
  retentionUntil DateTime
  deletedAt      DateTime?
  deletedById    String?
  createdAt      DateTime  @default(now())

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, subjectType, subjectId])
  @@index([retentionUntil])
}

/// A withdrawal the customer asked for from the portal.
///
/// This is a request, never a posting: the office decides, and approving it runs
/// the same withdrawal action the staff screen uses. The amount is stored in
/// integer pesewa so no rounding can happen between the request and the ledger.
model CustomerWithdrawalRequest {
  id                    String    @id @default(cuid())
  tenantId              String?
  /// Branch responsible at creation. Never rewritten by later transfers.
  branchId              String?
  reference             String
  customerId            String
  accountId             String
  cycleId               String?
  /// Integer pesewa. GH¢1.00 is 100.
  amountPesewa          Int
  reason                String
  /// requested | approved | paid | rejected | cancelled | needs_review
  status                String    @default("requested")
  requestedById         String
  decidedById           String?
  decidedAt             DateTime?
  decisionNote          String?
  /// The real withdrawal this request produced, when one was recorded.
  resultingWithdrawalId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant   BusinessTenant? @relation(fields: [tenantId], references: [id])
  customer Customer        @relation(fields: [customerId], references: [id])
  account  SusuAccount     @relation(fields: [accountId], references: [id])

  @@unique([tenantId, reference])
  @@index([customerId, status])
  @@index([tenantId, status, createdAt])
  @@index([branchId])
}

model CustomerDispute {
  id                 String    @id @default(cuid())
  tenantId           String?
  reference          String
  customerId         String
  accountId          String?
  /// contribution | withdrawal
  subjectType        String
  subjectId          String
  /// Snapshot of the transaction reference at the time of the dispute.
  subjectReference   String
  subjectAmount      Decimal
  /// Cycle number snapshotted when the dispute is opened.
  cycleNumber        Int?
  /// not_received | wrong_amount | duplicate_charge | unauthorised | other
  category           String
  details            String
  /// Receipt, statement line or other evidence reference supplied by the customer.
  customerEvidence   String?
  /// Evidence reference recorded by the administrator at resolution.
  resolutionEvidence String?
  /// open | under_review | awaiting_customer | resolved_upheld |
  /// resolved_declined | cancelled
  status             String    @default("open")
  openedByType       String    @default("customer")
  openedById         String
  resolutionNote     String?
  resolutionById     String?
  resolvedAt         DateTime?
  /// Optional correction/reversal reference recorded when an outcome is upheld.
  outcomeReference   String?
  /// Who is working on it, how urgent it is and when it is due.
  assignedToId       String?
  /// low | normal | high | urgent
  priority           String    @default("normal")
  dueAt              DateTime?
  escalatedAt        DateTime?
  escalationNote     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant   BusinessTenant?        @relation(fields: [tenantId], references: [id])
  customer Customer               @relation(fields: [customerId], references: [id])
  account  SusuAccount?           @relation(fields: [accountId], references: [id])
  events   CustomerDisputeEvent[]

  @@unique([tenantId, reference])
  @@unique([tenantId, subjectType, subjectId])
  @@index([tenantId, status])
  @@index([customerId, createdAt])
  @@index([accountId])
}

model CustomerDisputeEvent {
  id        String   @id @default(cuid())
  tenantId  String?
  disputeId String
  /// customer | admin | system
  actorType String
  actorId   String?
  action    String
  note      String?
  createdAt DateTime @default(now())

  tenant  BusinessTenant? @relation(fields: [tenantId], references: [id])
  dispute CustomerDispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId, createdAt])
  @@index([tenantId, createdAt])
}

model Contribution {
  id                 String    @id @default(cuid())
  tenantId           String?
  /// Branch responsible at creation. Never rewritten by later transfers.
  branchId           String?
  accountId          String
  cycleId            String
  amount             Decimal // Total amount collected in this event
  collectionDate     DateTime
  channel            String // collector | direct_office
  collectorId        String? // Reference to Collector if collected via collector
  recordedById       String // User who recorded the payment
  receivedById       String? // Staff (User) who recorded/authorised the office payment (audit)
  receivedByName     String? // Free-text name of the staff who physically received the money
  recordedByName     String? // Free-text name of the person who recorded the payment (display)
  /// Enrolled device that submitted an offline collection. Null for online
  /// office/collector recording, which is attributed to the authenticated user.
  recordedDeviceId   String?
  recordedDeviceName String?
  /// Original device capture time for an offline collection. Evidence only:
  /// financial ordering and period reporting use `collectionDate`, which is the
  /// server posting time and cannot be supplied by the client.
  capturedAt         DateTime?
  referenceId        String    @unique // Idempotency key - prevents duplicate submissions
  notes              String?
  createdAt          DateTime  @default(now())
  reversedAt         DateTime?
  reversalOfId       String?   @unique // Original record when this row is a reversal

  account     SusuAccount              @relation(fields: [accountId], references: [id])
  cycle       SusuCycle                @relation(fields: [cycleId], references: [id])
  collector   Collector?               @relation(fields: [collectorId], references: [id])
  recordedBy  User                     @relation("RecordedContributions", fields: [recordedById], references: [id])
  receivedBy  User?                    @relation("ReceivedContributions", fields: [receivedById], references: [id])
  allocations ContributionAllocation[]
  remittanceLinks RemittanceContribution[]

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([accountId])
  @@index([cycleId])
  @@index([collectionDate])
  @@index([channel])
  @@index([collectorId])
  @@index([receivedById])
  @@index([referenceId])
  @@index([tenantId])
  @@index([branchId])
}

model ContributionAllocation {
  id             String   @id @default(cuid())
  tenantId       String?
  contributionId String
  cycleDay       Int // Which day in the cycle (1-31) this allocation covers
  amount         Decimal // Amount allocated to this day
  createdAt      DateTime @default(now())

  contribution Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([contributionId])
  @@index([cycleDay])
  @@index([tenantId])
}

model Withdrawal {
  id               String    @id @default(cuid())
  tenantId         String?
  /// Branch responsible at creation. Never rewritten by later transfers.
  branchId         String?
  accountId        String
  cycleId          String
  requestedAmount  Decimal // What the customer asked to withdraw
  commissionAmount Decimal   @default(0) // Commission deducted (one-day contribution if first withdrawal)
  netAmount        Decimal // Amount actually paid to customer
  remainingBalance Decimal // Balance left after withdrawal
  status           String    @default("completed") // completed | pending | rejected
  authorizedById   String // Admin who authorized
  referenceId      String    @unique // Idempotency key
  notes            String?
  createdAt        DateTime  @default(now())
  reversedAt       DateTime?
  reversalOfId     String?   @unique // Original record when this row is a reversal

  account SusuAccount @relation(fields: [accountId], references: [id])
  cycle   SusuCycle   @relation(fields: [cycleId], references: [id])

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([accountId])
  @@index([cycleId])
  @@index([createdAt])
  @@index([referenceId])
  @@index([tenantId])
  @@index([branchId])
}

model Commission {
  id           String   @id @default(cuid())
  tenantId     String?
  accountId    String
  cycleId      String
  amount       Decimal // Equals one day's contribution
  basis        String // "one_day_contribution"
  triggeredBy  String // "first_withdrawal"
  recordedById String
  createdAt    DateTime @default(now())

  account SusuAccount @relation(fields: [accountId], references: [id])
  cycle   SusuCycle   @relation(fields: [cycleId], references: [id])

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([accountId])
  @@index([cycleId])
  @@index([tenantId])
}

model CardFee {
  id           String   @id @default(cuid())
  tenantId     String?
  accountId    String
  amount       Decimal  @default(10) // GH₵10 card fee
  recordedById String
  notes        String?
  createdAt    DateTime @default(now())

  account SusuAccount @relation(fields: [accountId], references: [id])

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([accountId])
  @@index([tenantId])
}

model Collector {
  id        String   @id @default(cuid())
  tenantId  String?
  /// Branch responsible at creation. Never rewritten by later transfers.
  branchId  String?
  userId    String   @unique
  /// Lifecycle: active | inactive | suspended. Only `active` may perform new
  /// collection operations. `suspended` is a control action and `inactive` an
  /// employment state; the distinction is preserved, and neither deletes the
  /// collector or rewrites their historical financial attribution.
  status    String   @default("active")
  /// Why the last lifecycle change happened. Written only by an administrator.
  statusReason      String?
  statusChangedAt   DateTime?
  statusChangedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User                          @relation(fields: [userId], references: [id])
  assignments   CollectorCustomerAssignment[]
  contributions Contribution[]
  remittances   CollectorRemittance[]
  assignmentEvents CollectorAssignmentEvent[]
  reconciliations SusuReconciliation[]
  dailyClosings  DailyCollectorClosing[]
  exceptionCases ReconciliationExceptionCase[]

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([status])
  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, status])
}

model CollectorCustomerAssignment {
  id           String    @id @default(cuid())
  tenantId     String?
  collectorId  String
  customerId   String
  accountId    String
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?
  active       Boolean   @default(true)
  /// Mirrors `accountId` while this assignment is active and is NULL once it is
  /// released. The unique index makes "at most one active collector per account"
  /// a database invariant on both SQLite and PostgreSQL (NULL rows never
  /// collide), instead of a pre-check that two concurrent requests can both pass.
  activeAccountKey String? @unique
  /// Administrator who created the current assignment/transfer.
  assignedById String?

  collector Collector   @relation(fields: [collectorId], references: [id])
  customer  Customer    @relation(fields: [customerId], references: [id])
  account   SusuAccount @relation(fields: [accountId], references: [id])
  events    CollectorAssignmentEvent[]

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  // The same collector/account pair may reappear across history (for example
  // after a deactivation/reactivation cycle), so the pair itself is NOT unique.
  // At most one ACTIVE assignment per account is enforced instead by
  // `activeAccountKey`, which is NULL when inactive (NULL rows never collide
  // in a unique index on SQLite or PostgreSQL).
  @@index([collectorId])
  @@index([customerId])
  @@index([accountId])
  @@index([tenantId])
  @@index([tenantId, active])
}

model CollectorRemittance {
  id             String    @id @default(cuid())
  tenantId       String?
  /// Branch responsible at creation. Never rewritten by later transfers.
  branchId       String?
  collectorId    String
  expectedAmount Decimal
  remittedAmount Decimal
  variance       Decimal
  status         String    @default("draft")

  method                 String    @default("cash")
  provider               String?
  transactionReference   String?
  transactionAt          DateTime?
  evidenceRef            String?
  declarationNote        String?
  declaredById           String?
  submittedAt            DateTime?
  declaredAmount         Decimal?

  handoverAmount         Decimal?
  handoverAt             DateTime?
  receiverId             String?
  receivingBranchId      String?
  custodyConfirmedAt     DateTime?
  custodyConfirmedById   String?

  receivedAmount         Decimal?
  receivedAt             DateTime?
  receivedById           String?
  receiptNote            String?
  receiptEvidenceRef     String?

  verifiedAmount         Decimal?
  verifiedAt             DateTime?
  verifiedById           String?
  verificationNote       String?
  verificationEvidenceRef String?

  outstandingAmount      Decimal   @default(0)
  disputedAmount         Decimal   @default(0)
  reconciliationStatus   String    @default("pending")

  recordedById   String
  referenceId    String    @unique
  idempotencyKey String?
  requestHash    String?
  notes          String?
  reversedAt     DateTime?
  reversedById   String?
  reversalReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  collector      Collector @relation(fields: [collectorId], references: [id])
  contributions  RemittanceContribution[]
  discrepancies  RemittanceDiscrepancy[]

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([collectorId])
  @@index([status])
  @@index([createdAt])
  @@index([referenceId])
  @@index([tenantId])
  @@index([branchId])
  @@index([method])
  @@index([receivingBranchId])
}

/// Append-only history of collector/customer assignments, transfers and
/// releases. Exactly one row is written per change, so the previous collector,
/// new collector, actor, timestamp and reason survive even when the assignment
/// row itself is deactivated or reactivated.
model CollectorAssignmentEvent {
  id           String   @id @default(cuid())
  tenantId     String?
  assignmentId String
  customerId   String
  accountId    String
  /// Collector the assignment belongs to after the event.
  collectorId  String?
  previousCollectorId String?
  newCollectorId      String?
  /// assigned | reactivated | transferred | unassigned
  kind         String
  reason       String?
  actorId      String
  createdAt    DateTime @default(now())

  assignment CollectorCustomerAssignment @relation(fields: [assignmentId], references: [id])
  collector  Collector?                  @relation(fields: [collectorId], references: [id])

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, accountId, createdAt])
  @@index([assignmentId, createdAt])
  @@index([collectorId, createdAt])
  @@index([actorId, createdAt])
}

/// Money a remittance declaration settles, per contribution. `amount` may be
/// LESS than the contribution's own amount: a partial handover settles part of
/// a contribution now and the remainder in a later declaration. The same
/// contribution may therefore appear in more than one declaration, but each
/// (remittance, contribution) pair appears once and the allocated total may
/// never exceed the contribution amount (enforced server-side inside the
/// collector's settlement lock).
model RemittanceContribution {
  id             String   @id @default(cuid())
  tenantId       String?
  remittanceId   String
  contributionId String
  amount         Decimal
  createdAt      DateTime @default(now())

  remittance   CollectorRemittance @relation(fields: [remittanceId], references: [id], onDelete: Cascade)
  contribution Contribution        @relation(fields: [contributionId], references: [id])

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@unique([remittanceId, contributionId])
  @@index([remittanceId])
  @@index([contributionId])
  @@index([tenantId])
}

model RemittanceDiscrepancy {
  id                String    @id @default(cuid())
  tenantId          String?
  remittanceId      String
  type              String
  expectedAmount    Decimal
  declaredAmount    Decimal
  receivedAmount    Decimal?
  verifiedAmount    Decimal?
  variance          Decimal
  reason            String
  status            String    @default("open")
  responsibleParty  String?
  evidenceRef       String?
  resolutionActorId String?
  resolutionAt      DateTime?
  resolutionNotes   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  remittance CollectorRemittance @relation(fields: [remittanceId], references: [id], onDelete: Cascade)

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([remittanceId])
  @@index([status])
  @@index([tenantId])
}


/// Immutable snapshot of a daily account before an administrative correction.
/// The live DailyAccount row carries the corrected figures; this table preserves
/// the exact prior values, reason, author and version so history is auditable.
model DailyAccountRevision {
  id             String   @id @default(cuid())
  tenantId       String?
  dailyAccountId String
  version        Int
  snapshot       String // JSON of the financial fields and expenses before correction
  reason         String
  correctedById  String
  createdAt      DateTime @default(now())

  dailyAccount DailyAccount @relation(fields: [dailyAccountId], references: [id], onDelete: Cascade)

  @@unique([dailyAccountId, version])
  @@index([dailyAccountId])
  @@index([tenantId])
  @@index([createdAt])
}

// =====================
// PASSWORD RECOVERY
// =====================

model EmailVerificationToken {
  id                   String    @id @default(cuid())
  tenantId             String?
  userId               String
  tokenHash            String    @unique // SHA-256 hash of the raw token - never store raw token
  // SEC-14: hash of the normalized destination address this token was issued
  // for. Verification refuses when it differs from the account's current
  // normalized address. Null on legacy rows, which are invalidated.
  destinationEmailHash String?
  expiresAt            DateTime
  usedAt               DateTime?
  createdAt            DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([tenantId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tenantId  String?
  userId    String
  tokenHash String    @unique // SHA-256 hash of the raw token — never store raw token
  expiresAt DateTime // Token expires after 15 minutes
  usedAt    DateTime? // Null until successfully used
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([tenantId])
}

// =====================
// OFFLINE / DEVICE ENROLLMENT
// =====================

model DeviceEnrollment {
  id           String    @id @default(cuid())
  tenantId     String?
  userId       String
  deviceId     String    @unique // Client-generated unique device identifier
  deviceName   String? // Human-readable device label
  module       String // "momo" | "susu"
  status       String    @default("active") // active | revoked
  lastSyncAt   DateTime?
  authorizedAt DateTime  @default(now()) // When last authorized (for offline timeout)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@index([deviceId])
  @@index([status])
  @@index([tenantId])
}

model OfflineTransaction {
  id             String    @id @default(cuid())
  tenantId       String?
  /// Branch responsible at creation. Never rewritten by later transfers.
  branchId       String?
  deviceId       String
  userId         String
  type           String // "contribution" | "daily_account_draft"
  idempotencyKey String    @unique // deviceId + UUID — server dedup key
  payload        String // JSON-encrypted transaction data
  status         String    @default("pending_sync") // pending_sync | syncing | synced | failed
  retryCount     Int       @default(0)
  maxRetries     Int       @default(5)
  failureReason  String?
  serverResult   String? // JSON server response after sync
  localTimestamp DateTime  @default(now()) // When first received by the server
  /// Original device capture time supplied with the payload and validated
  /// against server bounds. Never used for financial ordering.
  capturedAt     DateTime?
  syncStartedAt  DateTime?
  syncedAt       DateTime? // When server confirmed
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])

  @@index([deviceId])
  @@index([userId])
  @@index([idempotencyKey])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, status, createdAt])
}

/// Append-only trace of every offline contribution synchronization outcome,
/// including rejected and failed attempts that never reach OfflineTransaction.
/// Only safe context is stored: no encrypted payload, no device key, and no
/// authentication material. Collectors cannot read or write these rows; only an
/// authorized tenant administrator can review or resolve them.
model OfflineSyncAttempt {
  id             String    @id @default(cuid())
  tenantId       String?
  /// contribution | request
  kind           String    @default("contribution")
  /// accepted | already_synced | rejected | failed
  outcome        String
  /// Stable machine code, e.g. assignment_not_found, invalid_amount, device_revoked.
  reasonCode     String?
  /// Human-readable reason safe to show an administrator.
  reason         String?
  /// Whether an authorized administrator may safely retry the attempt.
  retryable      Boolean   @default(false)
  httpStatus     Int?
  userId         String
  deviceId       String?
  idempotencyKey String?
  accountId      String?
  collectorId    String?
  amount         Decimal?
  capturedAt     DateTime?
  payloadDigest  String?
  retriedAt      DateTime?
  retriedById    String?
  /// resolved | dismissed
  resolution     String?
  resolvedAt     DateTime?
  resolvedById   String?
  /// The reconciliation session currently reviewing this attempt (optional).
  reconciliationId String?
  createdAt      DateTime @default(now())

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])
  reconciliation SusuReconciliation? @relation(fields: [reconciliationId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, outcome, createdAt])
  @@index([tenantId, retryable, createdAt])
  @@index([idempotencyKey])
  @@index([userId, createdAt])
  @@index([reconciliationId, createdAt])
}

/// A reconciliation session: one bounded attempt to compare what was recorded
/// against what was physically collected, declared, handed over, received and
/// verified for one branch over one period.
///
/// Session types:
///   daily_close   — daily collector closing (operational handover).
///   branch_close  — branch-level reconciliation across collectors.
///   remittance    — reconciliation against a formal Phase 3 remittance.
///   sync          — offline synchronization exceptions.
///   other         — contribution inconsistencies or other Susu exceptions.
///
/// Statuses:
///   open            — session created, lines not yet finalised.
///   matching        — difference detection is running / in progress.
///   reviewed        — all lines reviewed by an authorised reviewer.
///   case_created    — exception case(s) raised for unresolved differences.
///   closed          — session closed; no further lines may be added.
///
/// A session is an audit boundary: it never edits a financial record. It only
/// observes server-side records and records the observed differences.
/// A reconciliation session: one bounded attempt to compare what was recorded
/// against what was physically collected, declared, handed over, received and
/// verified for one branch (or one collector-day) over one period.
///
/// Session types:
///   daily_close   — daily collector closing (operational handover).
///   branch_close  — branch-level reconciliation across collectors.
///   remittance    — reconciliation against formal Phase 3 remittances.
///   sync          — offline synchronization exceptions.
///   other         — contribution inconsistencies or other Susu exceptions.
///
/// Statuses: open | matching | matched | reviewed | case_created | closed.
/// A closed session is terminal and immutable. Detection may run again only
/// while the session is open or matched.
///
/// A session is an audit boundary: it never edits a financial record. It only
/// observes server-side records and records the observed differences.
model SusuReconciliation {
  id            String   @id @default(cuid())
  tenantId      String?
  /// Branch this session covers. null = company-wide (only company-wide admins).
  branchId      String?
  /// Set for a daily_close session scoped to one collector.
  collectorId   String?
  /// daily_close | branch_close | remittance | sync | other
  type          String
  /// open | matching | matched | reviewed | case_created | closed
  status        String   @default("open")
  /// Period covered by the session (both bounds inclusive, UTC day granularity).
  periodStart   DateTime
  periodEnd     DateTime

  /// Financial summary (definitionVersion 1). Computed from server-side records
  /// on each matching run and stored so the exact figures that justified any
  /// downstream case are preserved.
  summaryJson   String   @default("{}")
  /// Version of the financial definitions used to build summaryJson.
  definitionVersion Int  @default(1)
  /// Number of completed detection runs. Concurrency guard for status=matching.
  runCount      Int      @default(0)
  lastRunAt     DateTime?
  lastRunById   String?

  openedById    String
  openedAt      DateTime @default(now())
  closedAt      DateTime?
  closedById    String?
  closeReason   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        BusinessTenant?   @relation(fields: [tenantId], references: [id])
  branch        Location?         @relation(fields: [branchId], references: [id])
  collector     Collector?        @relation(fields: [collectorId], references: [id])
  lines         ReconciliationLine[]
  adjustments   ReconciliationAdjustment[]
  syncAttempts  OfflineSyncAttempt[]
  cases         ReconciliationExceptionCase[]
  dailyClosings DailyCollectorClosing[]

  @@index([tenantId, status, type])
  @@index([tenantId, branchId, status])
  @@index([tenantId, collectorId, periodStart])
  @@index([tenantId, type, openedAt])
  @@index([branchId, openedAt])
}

/// Daily collector closing: the operational handover record for one collector
/// on one business day. It is deliberately separate from a formal Phase 3
/// remittance, which is an independent finance-verified settlement instrument.
///
/// Lifecycle: open -> declared -> handed_over -> received -> balanced|exception.
/// A closing never edits a contribution or remittance.
///
/// Financial definitions:
///   expectedCash              server-recorded non-reversed contributions for
///                             the collector on the closing day.
///   contributionsRecorded     same as expectedCash, kept explicit for display.
///   contributionsSynced       recorded contributions captured offline and now
///                             accepted by the server (recordedDeviceId set).
///   contributionsPending      known amounts still awaiting a successful sync.
///   declaredCash              cash the collector says they hold.
///   handoverAmount            cash the collector physically handed over.
///   receivedAmount            cash office staff physically counted and received.
///   varianceExpectedVsDeclared expectedCash - declaredCash (positive=shortfall).
///   varianceDeclaredVsReceived declaredCash - receivedAmount.
///   varianceExpectedVsReceived expectedCash - receivedAmount.
///   outstandingAmount          expectedCash - receivedAmount once received,
///                             never negative (overage is reported separately).
model DailyCollectorClosing {
  id             String   @id @default(cuid())
  tenantId       String?
  branchId       String?
  collectorId    String
  /// UTC midnight of the business day this closing covers.
  closingDate    DateTime
  /// open | declared | handed_over | received | balanced | exception
  status         String   @default("open")

  expectedCash            Decimal @default(0)
  contributionsRecorded   Decimal @default(0)
  contributionsSynced     Decimal @default(0)
  contributionsPending    Decimal @default(0)
  pendingSyncCount        Int     @default(0)
  failedSyncCount         Int     @default(0)

  declaredCash            Decimal?
  declaredAt              DateTime?
  declaredById            String?
  declarationNote         String?
  declarationEvidenceRef  String?

  handoverAmount          Decimal?
  handedOverAt            DateTime?
  handedOverById          String?
  handoverEvidenceRef     String?

  receivedAmount          Decimal?
  receivedAt              DateTime?
  receivedById            String?
  receiptNote             String?
  receiptEvidenceRef      String?

  varianceExpectedVsDeclared Decimal @default(0)
  varianceDeclaredVsReceived Decimal @default(0)
  varianceExpectedVsReceived Decimal @default(0)
  outstandingAmount          Decimal @default(0)

  /// Reconciliation session that reviewed this closing (optional).
  sessionId        String?
  /// Exception case raised for the difference (optional).
  exceptionCaseId  String?
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant        BusinessTenant?             @relation(fields: [tenantId], references: [id])
  branch        Location?                  @relation(fields: [branchId], references: [id])
  collector     Collector                  @relation(fields: [collectorId], references: [id])
  session       SusuReconciliation?        @relation(fields: [sessionId], references: [id])
  exceptionCase ReconciliationExceptionCase? @relation(fields: [exceptionCaseId], references: [id])

  @@unique([tenantId, collectorId, closingDate])
  @@index([tenantId, branchId, closingDate])
  @@index([tenantId, status, closingDate])
  @@index([tenantId, collectorId, status])
  @@index([tenantId, exceptionCaseId])
}

/// One line inside a reconciliation session: one linked source record plus the
/// observed declared, received and verified amounts and the resulting variance.
///
/// entityType is polymorphic: contribution | collector_remittance |
/// offline_transaction | withdrawal | daily_account | other.
/// status: matched | unmatched | shortfall | overage | duplicate |
/// missing_evidence | sync_failure | reviewed
/// One observed source record inside a reconciliation session.
///
/// fingerprint identifies the business fact (for example
/// remittance:<id> or daily_closing:<id>:declared_vs_received). revision
/// increments only when an earlier revision is already reviewed or attached to
/// an exception case and the observed amounts have since changed. Earlier
/// revisions are never overwritten: they remain the evidence trail.
///
/// entityType is polymorphic: contribution | collector_remittance |
/// remittance_discrepancy | daily_closing | offline_sync_attempt |
/// offline_transaction | withdrawal_exception | other.
///
/// status: matched | unmatched | shortfall | overage | duplicate |
/// missing_evidence | sync_failure | pending_sync | reviewed.
model ReconciliationLine {
  id           String   @id @default(cuid())
  tenantId     String?
  branchId     String?
  collectorId  String?
  sessionId    String
  /// The source record this line observes (never edited by this session).
  entityType   String
  entityId     String
  /// Stable business fingerprint inside the session (see above).
  fingerprint  String
  /// Revision of this fingerprint. Revision 1 is the first observation.
  revision     Int      @default(1)
  /// What the records say should have been collected/handed over.
  expectedAmount   Decimal?
  /// What was physically declared by the collector.
  declaredAmount   Decimal?
  /// What was physically handed over by the collector.
  physicalAmount   Decimal?
  /// What office staff actually received and counted.
  receivedAmount   Decimal?
  /// What finance independently verified.
  verifiedAmount   Decimal?
  /// expectedAmount - (verifiedAmount ?? receivedAmount ?? physicalAmount ??
  /// declaredAmount ?? 0). Positive = shortfall, negative = overage.
  variance         Decimal @default(0)
  /// Classification (never an accusation).
  status           String
  /// low | medium | high — operational priority, not a risk score.
  severity         String?
  /// Human-readable classification reason.
  reason           String?
  /// Supporting detail (reference ids, reasons, previous amounts) as JSON.
  metadataJson     String?
  /// Whether this revision has been reviewed by an authorised person.
  reviewedAt       DateTime?
  reviewedById     String?
  /// Link to an exception case raised for this line (optional; one case may
  /// cover many lines).
  exceptionCaseId  String?
  /// Last detection run that observed this business fingerprint.
  lastSeenAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant      BusinessTenant?       @relation(fields: [tenantId], references: [id])
  session     SusuReconciliation    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exception   ReconciliationExceptionCase? @relation(fields: [exceptionCaseId], references: [id])

  @@unique([sessionId, fingerprint, revision])
  @@index([tenantId, sessionId, status])
  @@index([sessionId, entityType, entityId])
  @@index([tenantId, branchId, status])
  @@index([tenantId, collectorId, status])
  @@index([tenantId, status, createdAt])
}

/// A recorded but non-posting reconciliation adjustment: the observed corrective
/// figure that justifies a downstream correction, linked to the authorised
/// correction/reversal that actually posts it. Never edits a financial record
/// directly.
///
/// type: remittance_reversal | daily_account_correction | contribution_reversal
/// withdrawal_adjustment | other
/// status: proposed | linked | completed | rejected
model ReconciliationAdjustment {
  id          String   @id @default(cuid())
  tenantId    String?
  sessionId   String
  /// The correction workflow this adjustment references (remittance reversal,
  /// daily account correction, etc.). referenceType/referenceId are polymorphic.
  adjustmentType String
  referenceType  String
  referenceId    String
  /// The amounts that justify the correction (observed, not posted here).
  declaredAmount Decimal?
  correctedAmount Decimal?
  variance       Decimal   @default(0)
  /// proposed | linked | completed | rejected
  status         String   @default("proposed")
  reason         String?
  evidenceRef    String?
  /// Exception case this correction is attached to (optional).
  caseId         String?
  proposedById   String
  proposedAt     DateTime @default(now())
  linkedById     String?
  linkedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant   BusinessTenant?   @relation(fields: [tenantId], references: [id])
  session  SusuReconciliation @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, sessionId, status])
  @@index([sessionId, referenceType, referenceId])
  @@index([tenantId, caseId])
}

/// Phase 2: offline sync attempt trace, extended so a reconciliation session
/// can claim a failed or pending sync attempt for review. The original retryable
/// flag and outcome are preserved; only an administrator may resolve/dismiss.

// =====================
// PLATFORM / MULTI-TENANCY
// =====================

/// A single enrolled business on the platform. Every tenant-owned record
/// carries a tenantId pointing here; all tenant data access resolves this
/// record from the authenticated server session (never from browser input).
/// A member of an association (for example a MoMo agents' association).
/// Records are tenant-scoped and do not grant access to another business.
model AssociationMember {
  id            String    @id @default(cuid())
  tenantId      String?
  memberCode    String
  businessName  String
  contactName   String
  phone         String?
  email         String?
  region        String?
  /// invited | active | suspended | withdrawn
  status        String    @default("active")
  joinedAt      DateTime?
  notes         String?
  /// Which association and zone own this membership. Nullable so the existing
  /// tenant-wide register keeps working unchanged.
  associationId String?
  zoneId        String?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant             BusinessTenant?             @relation(fields: [tenantId], references: [id])
  association        Association?                @relation(fields: [associationId], references: [id])
  zone               AssociationZone?            @relation(fields: [zoneId], references: [id])
  sponsorships       AssociationSponsorship[]
  trainings          AssociationTrainingRecord[]
  trainingEnrolments TrainingEnrolment[]

  @@unique([tenantId, memberCode])
  @@unique([tenantId, phone])
  @@index([tenantId, status])
  @@index([tenantId, businessName])
}

/// An association that can span many member businesses.
///
/// The register rows below keep their own tenant for row-level scoping, while
/// `associationId` says which association owns them. A business may operate the
/// register for one association during the pilot; the entity exists so the model
/// does not have to pretend a single business is an association.
model Association {
  id             String   @id @default(cuid())
  tenantId       String?
  code           String
  name           String
  region         String?
  /// active | inactive
  status         String   @default("active")
  charterVersion String?
  contactEmail   String?
  contactPhone   String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant   BusinessTenant?             @relation(fields: [tenantId], references: [id])
  zones    AssociationZone[]
  members  AssociationMember[]
  roles    AssociationRoleAssignment[]
  courses  TrainingCourse[]
  consents AssociationConsentRecord[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

/// A zone or chapter inside an association. `parentZoneId` allows a region to
/// contain districts without a new table.
model AssociationZone {
  id            String   @id @default(cuid())
  tenantId      String?
  associationId String
  parentZoneId  String?
  code          String
  name          String
  region        String?
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      BusinessTenant?             @relation(fields: [tenantId], references: [id])
  association Association                 @relation(fields: [associationId], references: [id], onDelete: Cascade)
  parent      AssociationZone?            @relation("ZoneHierarchy", fields: [parentZoneId], references: [id])
  children    AssociationZone[]           @relation("ZoneHierarchy")
  members     AssociationMember[]
  roles       AssociationRoleAssignment[]

  @@unique([associationId, code])
  @@index([associationId, parentZoneId])
}

/// What a person may do inside an association.
///
/// Deliberately separate from the business role: an association auditor should
/// not inherit authority over a member business's money.
model AssociationRoleAssignment {
  id            String    @id @default(cuid())
  tenantId      String?
  associationId String
  zoneId        String?
  userId        String
  /// association_admin | zone_officer | member_viewer | auditor
  role          String
  grantedById   String
  grantedAt     DateTime  @default(now())
  revokedAt     DateTime?
  note          String?

  tenant      BusinessTenant?  @relation(fields: [tenantId], references: [id])
  association Association      @relation(fields: [associationId], references: [id], onDelete: Cascade)
  zone        AssociationZone? @relation(fields: [zoneId], references: [id])

  @@unique([associationId, userId, role])
  @@index([tenantId, role])
  @@index([userId, revokedAt])
}

/// A course an association delivers.
///
/// `passingScore` and `requiredAttendancePct` are the completion criteria: a
/// learner is completed by the rules, not by somebody choosing a status.
model TrainingCourse {
  id                    String   @id @default(cuid())
  tenantId              String?
  associationId         String
  code                  String
  title                 String
  version               String   @default("1")
  description           String?
  /// draft | published | retired
  status                String   @default("draft")
  passingScore          Int      @default(70)
  requiredAttendancePct Int      @default(80)
  /// How long an issued certificate stays valid.
  validityMonths        Int      @default(12)
  /// How long learner evidence is kept after the certificate expires.
  retentionYears        Int      @default(5)
  createdById           String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant      BusinessTenant?      @relation(fields: [tenantId], references: [id])
  association Association          @relation(fields: [associationId], references: [id], onDelete: Cascade)
  modules     TrainingModule[]
  sessions    TrainingSession[]
  assessments TrainingAssessment[]
  enrolments  TrainingEnrolment[]

  @@unique([associationId, code, version])
  @@index([tenantId, status])
}

/// One learning unit inside a course, in order.
model TrainingModule {
  id          String   @id @default(cuid())
  tenantId    String?
  courseId    String
  position    Int
  title       String
  content     String?
  resourceUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant BusinessTenant? @relation(fields: [tenantId], references: [id])
  course TrainingCourse  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, position])
  @@index([courseId])
}

/// A scheduled session a learner can attend.
model TrainingSession {
  id              String   @id @default(cuid())
  tenantId        String?
  courseId        String
  title           String
  scheduledAt     DateTime
  durationMinutes Int      @default(60)
  location        String?
  trainerName     String?
  /// scheduled | held | cancelled
  status          String   @default("scheduled")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant     BusinessTenant?      @relation(fields: [tenantId], references: [id])
  course     TrainingCourse       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attendance TrainingAttendance[]

  @@index([tenantId, courseId, scheduledAt])
}

/// A learner on a course.
///
/// The learner is either an association member contact or a staff user; both are
/// optional so a record is never orphaned silently.
model TrainingEnrolment {
  id          String    @id @default(cuid())
  tenantId    String?
  courseId    String
  memberId    String?
  userId      String?
  learnerName String
  /// enrolled | in_progress | completed | failed | withdrawn
  status      String    @default("enrolled")
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      BusinessTenant?             @relation(fields: [tenantId], references: [id])
  course      TrainingCourse              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  member      AssociationMember?          @relation(fields: [memberId], references: [id])
  attendance  TrainingAttendance[]
  attempts    TrainingAssessmentAttempt[]
  certificate TrainingCertificate?

  @@unique([courseId, memberId, userId])
  @@index([tenantId, status])
  @@index([courseId, learnerName])
}

/// Attendance at one session. Minutes are recorded so a partial attendance is
/// visible rather than counted as a full one.
model TrainingAttendance {
  id          String   @id @default(cuid())
  tenantId    String?
  sessionId   String
  enrolmentId String
  minutes     Int      @default(0)
  attendedAt  DateTime @default(now())
  markedById  String
  note        String?
  createdAt   DateTime @default(now())

  tenant    BusinessTenant?   @relation(fields: [tenantId], references: [id])
  session   TrainingSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrolment TrainingEnrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, enrolmentId])
  @@index([enrolmentId])
}

/// An assessment a course uses, with its pass mark.
model TrainingAssessment {
  id           String   @id @default(cuid())
  tenantId     String?
  courseId     String
  title        String
  maxScore     Int      @default(100)
  passingScore Int      @default(70)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   BusinessTenant?             @relation(fields: [tenantId], references: [id])
  course   TrainingCourse              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attempts TrainingAssessmentAttempt[]

  @@index([courseId])
}

/// One attempt at an assessment. The pass result is computed on write.
model TrainingAssessmentAttempt {
  id           String   @id @default(cuid())
  tenantId     String?
  assessmentId String
  enrolmentId  String
  score        Int
  passed       Boolean
  attemptedAt  DateTime @default(now())
  assessorName String?
  note         String?

  tenant     BusinessTenant?    @relation(fields: [tenantId], references: [id])
  assessment TrainingAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  enrolment  TrainingEnrolment  @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)

  @@index([enrolmentId, attemptedAt])
  @@index([assessmentId])
}

/// An issued certificate.
///
/// The serial is the human reference and the token is what a third party uses to
/// verify it; neither exposes contact details.
model TrainingCertificate {
  id                String    @id @default(cuid())
  tenantId          String?
  enrolmentId       String    @unique
  serial            String
  verificationToken String    @unique
  /// issued | revoked
  status            String    @default("issued")
  issuedAt          DateTime  @default(now())
  expiresAt         DateTime
  /// How long the certificate row itself is kept after expiry.
  retainUntil       DateTime
  revokedAt         DateTime?
  revokedById       String?
  revokedReason     String?
  issuedById        String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant    BusinessTenant?   @relation(fields: [tenantId], references: [id])
  enrolment TrainingEnrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, serial])
  @@index([tenantId, status, expiresAt])
}

/// A governance record: a membership agreement, a data-sharing consent or an
/// access review. Expiry and withdrawal are first-class so an expired consent
/// stops counting without deleting history.
model AssociationConsentRecord {
  id            String    @id @default(cuid())
  tenantId      String?
  associationId String
  memberId      String?
  /// membership_agreement | data_sharing | access_review
  subjectType   String
  grantedById   String
  grantedAt     DateTime  @default(now())
  expiresAt     DateTime?
  withdrawnAt   DateTime?
  documentRef   String?
  note          String?

  tenant      BusinessTenant? @relation(fields: [tenantId], references: [id])
  association Association     @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@index([tenantId, associationId, subjectType])
  @@index([expiresAt])
}

/// A sponsor: the party that funds an association member's subscription.
///
/// A sponsor is its own entity so eligibility, limits and reporting can be
/// answered by identity rather than by a free-text name.
model Sponsor {
  id              String   @id @default(cuid())
  tenantId        String?
  /// The sponsor's own business, when it has one. Used to refuse self-sponsorship.
  subjectTenantId String?
  name            String
  /// individual | business | association
  kind            String   @default("business")
  contactName     String?
  email           String?
  phone           String?
  taxId           String?
  /// active | inactive
  status          String   @default("active")
  /// Most a sponsor may commit in one calendar year, in integer pesewa.
  annualCapPesewa Int?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       BusinessTenant?          @relation(fields: [tenantId], references: [id])
  sponsorships AssociationSponsorship[]
  fundings     SponsorshipFunding[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
}

/// One movement of sponsor money against an agreed sponsorship.
///
/// Amounts are integer pesewa and every entry is append-only: a release is a new
/// row, never an edit of an earlier one.
model SponsorshipFunding {
  id            String   @id @default(cuid())
  tenantId      String?
  sponsorshipId String
  sponsorId     String
  /// allocation | release
  kind          String   @default("allocation")
  amountPesewa  Int
  fundedAt      DateTime @default(now())
  reference     String
  note          String?
  recordedById  String
  createdAt     DateTime @default(now())

  tenant      BusinessTenant?        @relation(fields: [tenantId], references: [id])
  sponsorship AssociationSponsorship @relation(fields: [sponsorshipId], references: [id], onDelete: Cascade)
  sponsor     Sponsor                @relation(fields: [sponsorId], references: [id])

  @@unique([tenantId, reference])
  @@index([sponsorshipId, fundedAt])
  @@index([sponsorId, fundedAt])
}

/// What sponsor money covers, and for which business.
///
/// The covered business keeps ownership of its own subscription and data; the
/// sponsor funds it and gains no entitlement. This record is the only place the
/// two are linked, which keeps the boundary visible.
model SponsorshipCoverage {
  id              String   @id @default(cuid())
  tenantId        String?
  sponsorshipId   String
  /// The member business whose subscription is covered.
  subjectTenantId String
  subscriptionId  String?
  periodStart     DateTime
  periodEnd       DateTime
  amountPesewa    Int
  /// active | ended
  status          String   @default("active")
  note            String?
  recordedById    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant      BusinessTenant?        @relation(fields: [tenantId], references: [id])
  sponsorship AssociationSponsorship @relation(fields: [sponsorshipId], references: [id], onDelete: Cascade)

  @@index([tenantId, sponsorshipId, periodEnd])
  @@index([subjectTenantId, periodEnd])
}

/// Sponsorship of one association member. This is a record of an agreed
/// sponsorship only. It never charges, pays out or changes a subscription.
model AssociationSponsorship {
  id              String    @id @default(cuid())
  tenantId        String?
  memberId        String
  sponsorName     String
  /// The sponsor entity, when one has been registered.
  sponsorId       String?
  /// The member business this sponsorship covers, when it is a tenant here.
  subjectTenantId String?
  /// Most this sponsorship may be funded with, in integer pesewa.
  fundedCapPesewa Int?
  planCode        String?
  amount          Decimal   @default(0)
  currency        String    @default("GHS")
  /// pledged | active | ended | cancelled
  status          String    @default("pledged")
  startDate       DateTime?
  endDate         DateTime?
  reference       String?
  notes           String?
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant    BusinessTenant?       @relation(fields: [tenantId], references: [id])
  member    AssociationMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sponsor   Sponsor?              @relation(fields: [sponsorId], references: [id])
  fundings  SponsorshipFunding[]
  coverages SponsorshipCoverage[]

  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@index([memberId, createdAt])
  @@index([sponsorId])
}

/// Training completed or scheduled by an association member.
model AssociationTrainingRecord {
  id                   String    @id @default(cuid())
  tenantId             String?
  memberId             String
  title                String
  provider             String?
  /// scheduled | completed | expired | cancelled
  status               String    @default("completed")
  completedAt          DateTime?
  expiresAt            DateTime?
  certificateReference String?
  notes                String?
  createdById          String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant BusinessTenant?   @relation(fields: [tenantId], references: [id])
  member AssociationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([memberId, completedAt])
}

