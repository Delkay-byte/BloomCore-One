# MaaCash — PILOT environment template
#
# Copy this file to `.env.pilot.local` and fill in real values.
# `.env.pilot.local` is ignored by Git. Never commit live credentials.
#
# Start pilot mode: npm run pilot
# Or: cp .env.pilot.local .env.local && npm run dev

# Database — PostgreSQL pilot database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# JWT signing secret — generate one with: openssl rand -base64 32
# Never reuse the development secret in a pilot or production environment.
JWT_SECRET="REPLACE_WITH_32_BYTE_RANDOM_SECRET"

# Dedicated HMAC key for rate-limit buckets (32+ characters).
RATE_LIMIT_HMAC_SECRET="REPLACE_WITH_32_BYTE_RANDOM_SECRET"

# 32-byte base64 or hex key used to encrypt MFA secrets at rest.
MFA_ENCRYPTION_KEY="REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY"

# Environment identifier — shows the PILOT badge.
APP_ENV="PILOT"

NODE_ENV="production"
